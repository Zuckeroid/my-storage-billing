{% set products = guest.product_get_list %}
<div class="znet-order-plan-list">
    <div class="znet-order-plan-list-head">
        <div>
            <h3>{{ 'Select Product'|trans }}</h3>
        </div>
        <span class="badge bg-info">{{ products.list|length }} {{ 'Items'|trans }}</span>
    </div>

    {% for i, category in guest.product_category_get_list.list %}
        <div class="znet-order-plan-category">
            <h4>{{ category.title }}</h4>
            {% if category.description %}
                <div class="znet-order-plan-description">{{ category.description|markdown }}</div>
            {% endif %}
            <div class="list-group">
                {% for i, product in category.products|sort((a, b) => a.priority <=> b.priority) %}
                    <a class="list-group-item" href="{{ 'orderbutton'|link({ 'product': product.id, 'show_custom_form_values': request.show_custom_form_values }) }}">
                        {{ product.title }}
                        <svg class="svg-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z" /></svg>
                    </a>
                {% endfor %}
            </div>
        </div>
    {% endfor %}
</div>
