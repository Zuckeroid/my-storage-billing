<script>
    document.addEventListener("DOMContentLoaded", function() {
        syncPopupIframeHeight();

        document.getElementById('show-promo-field')?.addEventListener('click', function(event) {
            event.preventDefault();
            document.getElementById('apply-promo').style.display = 'block';
            this.style.display = 'none';
            document.getElementById('promocode')?.focus();
        });

        document.querySelectorAll('.register-login a').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const bsTab = new bootstrap.Tab(this);
                bsTab.show();
            });
        });

        document.querySelectorAll('.znet-order-plan-card').forEach((card) => {
            const select = card.querySelector('[data-plan-period]');
            const price = card.querySelector('[data-plan-price]');

            if (!select || !price) {
                return;
            }

            const syncPlanCard = () => {
                const option = select.options[select.selectedIndex];

                if (option?.dataset.price) {
                    price.textContent = option.dataset.price;
                }
            };

            select.addEventListener('change', syncPlanCard);
            syncPlanCard();
        });

        document.querySelectorAll('.remove-cart-item').forEach(function(button) {
            button.addEventListener('click', function(event) {
                event.preventDefault();

                if (confirm("{{ is_en ? 'Remove this plan?' : 'Убрать этот тариф?' }}")) {
                    var item_id = this.getAttribute('data-cart-item-id');

                    API.guest.post("cart/remove_item", { id: item_id },
                        () => {
                            MyStorage.message("{{ is_en ? 'Plan was removed' : 'Тариф убран' }}");
                            window.location.reload();
                        });
                }
            });
        });
    });

    function syncPopupIframeHeight() {
        const iframe = document.getElementById('popup-iframe');

        if (iframe) {
            iframe.height = document.body.clientHeight;
        }
    }

    function showPaymentHtml() {
        const paymentHtmlEl = document.getElementById('payment-html');

        if (!paymentHtmlEl) {
            return;
        }

        paymentHtmlEl.hidden = false;
        paymentHtmlEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        syncPopupIframeHeight();
    }

    function onOrderCheckout(result){
        if (result.invoice_hash) {
            API.guest.post('invoice/payment', { hash: result.invoice_hash, gateway_id: result.gateway_id, auto_redirect: true },
                (r) => {
                    const checkoutEl = document.getElementById('checkout');
                    const checkoutInnerEl = document.getElementById('checkout-inner');
                    const paymentHtmlInnerEl = document.getElementById('payment-html-inner');

                    if (!paymentHtmlInnerEl) {
                        return;
                    }

                    if (r.iframe) {
                        paymentHtmlInnerEl.innerHTML = r.result;
                        checkoutEl?.remove();
                        showPaymentHtml();
                    } else {
                        const link = '{{ "invoice/banklink"|link }}' + '/' + result.invoice_hash + '/' + result.gateway_id + '?allow_subscription=0';
                        paymentHtmlInnerEl.innerHTML = '<a href="' + link + '" target="_parent" id="redirect-to-gateway">Redirect to payment gateway</a>';
                        checkoutInnerEl?.remove();
                        showPaymentHtml();
                        document.getElementById('redirect-to-gateway')?.click();
                    }
                });
        } else {
            window.top.location.href = ('{{ "order/service/manage"|link }}' + '/' + result.order_id);
        }
    }

    function unlockCheckoutAfterAuth() {
        const registerEl = document.getElementById('register');
        const checkoutButton = document.querySelector("#checkoutButton");
        const loginMessage = document.querySelector("#loginMessage");
        const checkoutEl = document.getElementById('checkout');

        registerEl?.remove();

        if (checkoutButton) {
            checkoutButton.hidden = false;
        }

        if (loginMessage) {
            loginMessage.hidden = true;
        }

        checkoutEl?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function onLogin(result){
        MyStorage.message("{{ 'You logged in successfully'|trans }}");
        unlockCheckoutAfterAuth();
    }

    function onAccountCreate(result){
        const login_details = {
            email: document.getElementById('reg-email').value,
            password: document.getElementById('reg-password').value
        };
        API.guest.post('client/login', login_details,
            () => {
                MyStorage.message("{{ 'You logged in successfully'|trans }}");
                unlockCheckoutAfterAuth();
            });
    }
</script>
