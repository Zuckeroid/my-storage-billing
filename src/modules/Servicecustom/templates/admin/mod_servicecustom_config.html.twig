<div class="card-body">
    <h5>{{ 'Stock control settings'|trans }}</h5>

    <h5>{{ 'Plugin'|trans }}</h5>
    <form method="post" action="{{ 'api/admin/product/update'|link }}" {{ fb_api_form({message: 'Settings Updated'|trans}) }}>
        <div class="form-group mb-3 row">
            <label class="form-label col-3 col-form-label">{{ 'Plugin name'|trans }}:</label>
            <div class="col">
                <input class="form-control" type="text" name="plugin" value="{{ product.plugin }}">
            </div>
        </div>
        <input type="hidden" name="id" value="{{ product.id }}">
        <input type="submit" value="{{ 'Update'|trans }}" class="btn btn-primary">
    </form>
    <hr>

    <form method="post" action="{{ 'api/admin/product/update_config'|link }}" {{ fb_api_form({reload: true}) }}>
        {% set appbridge_device_limit = product.config.appbridge_device_limit|default(product.config.device_limit|default(product.config.devices_limit|default(''))) %}
        {% set appbridge_reserved_keys = ['appbridge_device_limit', 'device_limit', 'devices_limit'] %}

        <h6>{{ 'Application access'|trans }}</h6>
        <div class="form-group mb-3 row">
            <label class="form-label col-3 col-form-label">{{ 'Device limit'|trans }}:</label>
            <div class="col">
                <input class="form-control" type="number" min="0" step="1" name="config[appbridge_device_limit]" value="{{ appbridge_device_limit }}">
                <div class="form-text">
                    {{ 'How many devices can be activated in the mobile application for this tariff. Leave empty to keep automatic fallback behavior.'|trans }}
                </div>
            </div>
        </div>

        <hr>

        <h6>Custom parameters</h6>
        {% for k, v in product.config %}
        {% if k not in appbridge_reserved_keys %}
        <div class="form-group mb-3 row">
            <label class="form-label col-3 col-form-label">{{ k }}:</label>
            <div class="col">
                <input class="form-control" type="text" name="config[{{ k }}]" value="{{ v }}">
            </div>
        </div>
        {% endif %}
        {% endfor %}

        <h6>Add custom parameter</h6>
        <div class="form-group mb-3 row">
            <label class="form-label col-3 col-form-label">{{ 'Parameter name'|trans }}:</label>
            <div class="col">
                <input class="form-control" type="text" name="new_config_name">
            </div>
        </div>

        <div class="form-group mb-3 row">
            <label class="form-label col-3 col-form-label">{{ 'Parameter value'|trans }}:</label>
            <div class="col">
                <textarea class="form-control" name="new_config_value" rows="7"></textarea>
            </div>
        </div>
        <input type="hidden" name="id" value="{{ product.id }}">
        <input type="submit" value="{{ 'Update configuration fields'|trans }}" class="btn btn-primary">
    </form>
</div>
