{% extends request.ajax ? "layout_blank.html.twig" : (client ? "layout_default.html.twig" : "layout_public.html.twig") %}

{% import "macro_functions.html.twig" as mf %}

{% set current_locale = guest.system_locale|default(settings.locale|default('ru_RU')) %}
{% set is_en = current_locale starts with 'en' %}
{% set company = guest.system_company %}
{% set storage_products = guest.product_get_list({ 'per_page': 100, 'show_hidden': false, 'type': 'custom' }).list|default([]) %}

{% block meta_title %}{% if client %}{{ is_en ? 'Client area' : 'Личный кабинет' }}{% else %}{{ is_en ? 'Private cloud storage and secure access' : 'Личное облачное хранилище и безопасный доступ' }}{% endif %}{% endblock %}
{% block meta_description %}{% if client %}{{ is_en ? 'Manage your storage plans, invoices, and access details.' : 'Управляйте тарифами хранения, счетами и доступом в одном кабинете.' }}{% else %}{{ is_en ? 'Store documents, family archives, and work files in one personal space with fast setup and clear online billing.' : 'Храните документы, семейные архивы и рабочие файлы в одном личном пространстве с быстрым подключением и понятной онлайн-оплатой.' }}{% endif %}{% endblock %}
{% block page_header %}{{ is_en ? 'Storage' : 'Хранилище' }}{% endblock %}
{% block body_class %}{% if client %}dashboard storage-dashboard{% else %}public-homepage{% endif %}{% endblock %}

{% block breadcrumbs %}
    {% if client and not settings.hide_dashboard_breadcrumb %}
        <ul class="breadcrumb">
            <li><a href="{{ '/'|link }}">{{ is_en ? 'Home' : 'Главная' }}</a> <span class="dropdown-divider">/</span></li>
            <li class="active">{{ is_en ? 'Storage' : 'Хранилище' }}</li>
        </ul>
    {% endif %}
{% endblock %}

{% block content %}
    {% if client %}
        {% set dashboard = client.index_get_dashboard %}
        {% set profile = dashboard.profile %}

        <section class="storage-page-head mb-4">
            <div>
                <span class="storage-kicker">{{ is_en ? 'Account' : 'Личный кабинет' }}</span>
                <h1 class="mb-2">{{ is_en ? 'Your cloud storage' : 'Ваше облачное хранилище' }}</h1>
                <p class="text-secondary mb-0">{{ is_en ? 'Choose a plan, pay the invoice, and access instructions will be sent to your account email.' : 'Выберите тариф, оплатите счет, а инструкции по доступу придут на email аккаунта.' }}</p>
            </div>
            <div class="storage-email-panel">
                <span>{{ is_en ? 'Instructions will be sent to' : 'Инструкции будут отправлены на' }}</span>
                <strong>{{ profile.email }}</strong>
            </div>
        </section>

        <section class="storage-metric-grid mb-4" aria-label="Account summary">
            <div class="storage-metric green">
                <span>{{ is_en ? 'Active services' : 'Активные услуги' }}</span>
                <strong>{{ dashboard.orders.active }}</strong>
            </div>
            <div class="storage-metric teal">
                <span>{{ is_en ? 'Unpaid invoices' : 'Неоплаченные счета' }}</span>
                <strong>{{ dashboard.invoices.unpaid }}</strong>
            </div>
            <div class="storage-metric yellow">
                <span>{{ is_en ? 'Available plans' : 'Тарифов доступно' }}</span>
                <strong>{{ storage_products|length }}</strong>
            </div>
        </section>

        <section class="row mb-4">
            {% include 'partial_storage_plans.html.twig' with { storage_plan_view: 'card_items', is_en: is_en } %}
        </section>

        <section class="storage-panel-grid">
            <div class="storage-panel">
                <div class="storage-panel-head">
                    <h2>{{ is_en ? 'My services' : 'Мои услуги' }}</h2>
                    <a class="btn btn-sm btn-outline-primary" href="{{ 'order/service'|link }}">{{ is_en ? 'Open' : 'Открыть' }}</a>
                </div>
                <p class="mb-2">{{ is_en ? 'Active services:' : 'Активные услуги:' }} <strong>{{ dashboard.orders.active }}</strong></p>
                <p class="mb-0 text-secondary">{{ is_en ? 'After payment, access details and instructions are sent to your email.' : 'После оплаты доступ и инструкции отправляются на email.' }}</p>
            </div>

            <div class="storage-panel">
                <div class="storage-panel-head">
                    <h2>{{ is_en ? 'Invoices' : 'Счета' }}</h2>
                    <a class="btn btn-sm btn-outline-primary" href="{{ 'invoice'|link }}">{{ is_en ? 'Open' : 'Открыть' }}</a>
                </div>
                <p class="mb-2">{{ is_en ? 'Unpaid invoices:' : 'Неоплаченные счета:' }} <strong>{{ dashboard.invoices.unpaid }}</strong></p>
                <p class="mb-0 text-secondary">{{ is_en ? 'You can review and pay all invoices in this section.' : 'В этом разделе можно проверить и оплатить все счета.' }}</p>
            </div>
        </section>

        {% if dashboard.recent_orders %}
            <section class="card mt-3">
                <div class="card-header">
                    <h2 class="h6 m-0">{{ is_en ? 'Recent services' : 'Последние услуги' }}</h2>
                </div>
                <div class="list-group list-group-flush">
                    {% for order in dashboard.recent_orders %}
                        <a href="{{ 'order/service/manage'|link }}/{{ order.id }}" class="list-group-item d-flex justify-content-between align-items-center">
                            <span>#{{ order.id }} {{ order.title|truncate(45) }}</span>
                            <span class="badge {% if order.status == 'active' %}text-bg-success{% elseif order.status == 'pending_setup' %}text-bg-warning{% elseif order.status == 'failed_setup' or order.status == 'suspended' or order.status == 'failed_renew' %}text-bg-danger{% elseif order.status == 'canceled' %}text-bg-secondary{% endif %}">{{ mf.status_name(order.status) }}</span>
                        </a>
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    {% endif %}
{% endblock %}

{% block body %}
    {% if not client %}
        <header class="public-site-header">
            <div class="public-site-shell">
                <a class="public-site-brand" href="{{ '/'|link }}">
                    <span class="brand-folder-icon" aria-hidden="true">
                        <svg class="svg-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M3 6.75C3 5.78 3.78 5 4.75 5h5.4l2 2h7.1C20.22 7 21 7.78 21 8.75v8.5c0 .97-.78 1.75-1.75 1.75H4.75C3.78 19 3 18.22 3 17.25V6.75Z"/>
                        </svg>
                    </span>
                    <span>{{ company.name }}</span>
                </a>
                <nav class="public-site-nav" aria-label="{{ is_en ? 'Main navigation' : 'Основная навигация' }}">
                    <a href="#plans">{{ is_en ? 'Plans' : 'Тарифы' }}</a>
                    <a href="#steps">{{ is_en ? 'How it works' : 'Как это работает' }}</a>
                    <a href="{{ '/payment'|link }}">{{ is_en ? 'Payment' : 'Оплата' }}</a>
                    <a href="{{ '/contacts'|link }}">{{ is_en ? 'Support' : 'Поддержка' }}</a>
                </nav>
                <div class="public-site-actions">
                    <a class="btn btn-outline-light btn-sm" href="{{ 'login'|link }}">{{ is_en ? 'Login' : 'Войти' }}</a>
                    <a class="btn btn-warning btn-sm" href="{{ 'signup'|link }}">{{ is_en ? 'Create account' : 'Создать аккаунт' }}</a>
                </div>
            </div>
        </header>

        <main class="public-site-main">
            <section class="public-hero">
                <div class="public-site-shell public-hero-shell">
                    <div class="public-hero-copy">
                        <span class="public-eyebrow">{{ is_en ? 'Private cloud storage' : 'Личное облачное хранилище' }}</span>
                        <h1>{{ is_en ? 'Private space for files you want close at hand.' : 'Личное пространство для файлов, которые всегда должны быть под рукой.' }}</h1>
                        <p>{{ is_en ? 'Pick a plan, pay online, and receive access details by email. No extra maze between the first visit and the real service.' : 'Выберите тариф, оплатите онлайн и получите доступ на email. Без лишнего лабиринта между первым визитом и реальной услугой.' }}</p>
                        <div class="public-hero-actions">
                            <a class="btn btn-warning btn-lg" href="#plans">{{ is_en ? 'Choose a plan' : 'Выбрать тариф' }}</a>
                            <a class="btn btn-outline-light btn-lg" href="{{ 'signup'|link }}">{{ is_en ? 'Open account' : 'Открыть аккаунт' }}</a>
                        </div>
                    </div>
                    <div class="public-hero-meta" aria-label="{{ is_en ? 'Highlights' : 'Ключевые преимущества' }}">
                        <span>{{ storage_products|length }} {{ is_en ? 'plans' : 'тарифа' }}</span>
                        <span>{{ is_en ? 'online billing' : 'онлайн-оплата' }}</span>
                        <span>{{ is_en ? 'access by email' : 'доступ по email' }}</span>
                    </div>
                </div>
            </section>

            <section class="public-quickline">
                <div class="public-site-shell public-quickline-grid">
                    <div class="public-quickline-item">
                        <strong>{{ is_en ? 'One account' : 'Один аккаунт' }}</strong>
                        <span>{{ is_en ? 'Plans, invoices, and service status in one place.' : 'Тарифы, счета и состояние услуги в одном кабинете.' }}</span>
                    </div>
                    <div class="public-quickline-item">
                        <strong>{{ is_en ? 'Fast start' : 'Быстрый старт' }}</strong>
                        <span>{{ is_en ? 'The path to the first setup is short and visible.' : 'Путь до первого подключения короткий и понятный.' }}</span>
                    </div>
                    <div class="public-quickline-item">
                        <strong>{{ is_en ? 'Clear delivery' : 'Понятная выдача' }}</strong>
                        <span>{{ is_en ? 'Access instructions arrive to the account email.' : 'Инструкции по доступу приходят на email аккаунта.' }}</span>
                    </div>
                </div>
            </section>

            <section id="plans" class="public-section public-plans">
                <div class="public-site-shell">
                    <div class="public-section-head">
                        <span class="public-section-kicker">{{ is_en ? 'Plans' : 'Тарифы' }}</span>
                        <h2>{{ is_en ? 'Choose the format that fits your files' : 'Выберите формат, который подходит вашим файлам и привычкам' }}</h2>
                        <p>{{ is_en ? 'Current plans are loaded directly from billing, so the homepage always shows the real catalog.' : 'Текущие тарифы подтягиваются прямо из биллинга, поэтому на главной всегда показан реальный каталог.' }}</p>
                    </div>

                    <div class="row">
                        {% include 'partial_storage_plans.html.twig' with { storage_plan_view: 'card_items', is_en: is_en } %}
                    </div>
                </div>
            </section>

            <section id="steps" class="public-section public-process">
                <div class="public-site-shell">
                    <div class="public-section-head">
                        <span class="public-section-kicker">{{ is_en ? 'Three steps' : 'Три шага' }}</span>
                        <h2>{{ is_en ? 'The whole start fits into a short, visible flow' : 'Весь старт укладывается в короткий и понятный сценарий' }}</h2>
                        <p>{{ is_en ? 'No extra onboarding maze: create an account, pay for the right plan, and get your access details.' : 'Без длинного онбординга: создайте аккаунт, оплатите нужный тариф и получите доступ.' }}</p>
                    </div>

                    <div class="public-process-grid">
                        <article class="public-process-step">
                            <span class="public-process-number">01</span>
                            <h3>{{ is_en ? 'Create an account' : 'Создайте аккаунт' }}</h3>
                            <p>{{ is_en ? 'Use the email where you want to receive invoices, status updates, and access instructions.' : 'Используйте тот email, на который удобно получать счета, статусы и инструкции по доступу.' }}</p>
                        </article>
                        <article class="public-process-step">
                            <span class="public-process-number">02</span>
                            <h3>{{ is_en ? 'Choose a storage plan' : 'Выберите тариф хранения' }}</h3>
                            <p>{{ is_en ? 'Compare the plans, pick the one that fits your file volume and routine, and move straight to checkout.' : 'Сравните тарифы, выберите подходящий объем и сразу переходите к оформлению заказа.' }}</p>
                        </article>
                        <article class="public-process-step">
                            <span class="public-process-number">03</span>
                            <h3>{{ is_en ? 'Receive your access details' : 'Получите доступ и инструкции' }}</h3>
                            <p>{{ is_en ? 'Pay online and receive the access details by email. The cabinet keeps the service status visible afterward.' : 'Оплатите онлайн и получите данные для доступа на email. Дальше кабинет показывает состояние услуги и счета.' }}</p>
                        </article>
                    </div>
                </div>
            </section>

            <section class="public-section public-trust-strip">
                <div class="public-site-shell public-trust-strip-shell">
                    <div class="public-trust-copy">
                        <span class="public-section-kicker">{{ is_en ? 'Before payment' : 'Перед оплатой' }}</span>
                        <h2>{{ is_en ? 'Everything important is one click away' : 'Все важное находится в одном клике до оформления' }}</h2>
                    </div>
                    <div class="public-link-stack public-link-stack-inline">
                        <a href="{{ '/payment'|link }}"><strong>{{ is_en ? 'Payment' : 'Оплата' }}</strong></a>
                        <a href="{{ '/about-us'|link }}"><strong>{{ is_en ? 'About service' : 'О сервисе' }}</strong></a>
                        <a href="{{ '/contacts'|link }}"><strong>{{ is_en ? 'Contacts' : 'Контакты' }}</strong></a>
                    </div>
                </div>
            </section>

            <section class="public-section public-final-cta">
                <div class="public-site-shell public-final-cta-shell">
                    <div>
                        <span class="public-section-kicker">{{ is_en ? 'Ready to start' : 'Можно начать сегодня' }}</span>
                        <h2>{{ is_en ? 'Create an account, choose a plan, and keep the rest predictable.' : 'Создайте аккаунт, выберите тариф и держите остальной путь предсказуемым.' }}</h2>
                        <p>{{ is_en ? 'Start from the plan list or go straight to account creation.' : 'Начните с выбора тарифа или сразу переходите к созданию аккаунта.' }}</p>
                    </div>
                    <div class="public-final-actions">
                        <a class="btn btn-warning btn-lg" href="#plans">{{ is_en ? 'See plans' : 'Посмотреть тарифы' }}</a>
                        <a class="btn btn-outline-dark btn-lg" href="{{ 'signup'|link }}">{{ is_en ? 'Create account' : 'Создать аккаунт' }}</a>
                    </div>
                </div>
            </section>
        </main>

        <footer class="public-site-footer">
            <div class="public-site-shell public-site-footer-shell">
                <div class="public-site-footer-brand">
                    <span class="brand-folder-icon" aria-hidden="true">
                        <svg class="svg-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M3 6.75C3 5.78 3.78 5 4.75 5h5.4l2 2h7.1C20.22 7 21 7.78 21 8.75v8.5c0 .97-.78 1.75-1.75 1.75H4.75C3.78 19 3 18.22 3 17.25V6.75Z"/>
                        </svg>
                    </span>
                    <div>
                        <strong>{{ company.name }}</strong>
                        <span>{{ is_en ? 'Private cloud storage and secure access' : 'Личное облачное хранилище и безопасный доступ' }}</span>
                    </div>
                </div>
                <nav class="public-site-footer-links" aria-label="{{ is_en ? 'Footer navigation' : 'Навигация в подвале' }}">
                    <a href="{{ '/payment'|link }}">{{ is_en ? 'Payment' : 'Оплата' }}</a>
                    <a href="{{ '/offer'|link }}">{{ is_en ? 'Offer' : 'Оферта' }}</a>
                    <a href="{{ '/privacy-policy'|link }}">{{ is_en ? 'Privacy' : 'Конфиденциальность' }}</a>
                    <a href="{{ '/contacts'|link }}">{{ is_en ? 'Contacts' : 'Контакты' }}</a>
                </nav>
            </div>
        </footer>
    {% endif %}
{% endblock %}
