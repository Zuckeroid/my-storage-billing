{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{% if client %}Личный кабинет{% else %}My Storage{% endif %}{% endblock %}
{% block page_header %}Хранилище{% endblock %}
{% block body_class %}dashboard storage-dashboard{% endblock %}

{% block breadcrumbs %}
    {% if not settings.hide_dashboard_breadcrumb %}
        <ul class="breadcrumb">
            <li><a href="{{ '/'|link }}">Главная</a> <span class="dropdown-divider">/</span></li>
            <li class="active">Хранилище</li>
        </ul>
    {% endif %}
{% endblock %}

{% set storage_plans = [
    {
        title: 'Storage Start',
        price: '290 ₽/месяц',
        devices: 'Защищенный доступ к файлам для 1 устройства',
        storage: '50 ГБ для личных файлов',
        description: 'Для документов, фотографий и небольшого личного архива.',
        href: '/order/storage-start'
    },
    {
        title: 'Storage Plus',
        price: '790 ₽/месяц',
        devices: 'Защищенный доступ к файлам для 3 устройств',
        storage: '200 ГБ для личных файлов',
        description: 'Для повседневного хранения на нескольких личных устройствах.',
        href: '/order/storage-plus'
    },
    {
        title: 'Storage Family',
        price: '1190 ₽/месяц',
        devices: 'Защищенный доступ к файлам для 5 устройств',
        storage: '500 ГБ для личных файлов',
        description: 'Для большого личного архива и семейного хранения файлов.',
        href: '/order/storage-family'
    }
] %}

{% block content %}
    {% if client %}
        {% set dashboard = client.index_get_dashboard %}
        {% set profile = dashboard.profile %}

        <section class="storage-page-head mb-4">
            <div>
                <span class="storage-kicker">Личный кабинет</span>
                <h1 class="mb-2">Ваше облачное хранилище</h1>
                <p class="text-secondary mb-0">Выберите тариф, оплатите счет, а инструкции по доступу придут на email аккаунта.</p>
            </div>
            <div class="storage-email-panel">
                <span>Инструкции будут отправлены на</span>
                <strong>{{ profile.email }}</strong>
            </div>
        </section>

        <section class="storage-metric-grid mb-4" aria-label="Account summary">
            <div class="storage-metric green">
                <span>Активные услуги</span>
                <strong>{{ dashboard.orders.active }}</strong>
            </div>
            <div class="storage-metric teal">
                <span>Неоплаченные счета</span>
                <strong>{{ dashboard.invoices.unpaid }}</strong>
            </div>
            <div class="storage-metric yellow">
                <span>Тарифов доступно</span>
                <strong>3</strong>
            </div>
        </section>

        <section class="row mb-4">
            {% for plan in storage_plans %}
                <div class="col-md-4 mb-3">
                    <div class="card h-100 storage-plan-card">
                        <div class="card-body d-flex flex-column">
                            <span class="storage-card-icon" aria-hidden="true">
                                <svg class="svg-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                    <path d="M4 4.75C4 3.78 4.78 3 5.75 3h6.5L18 8.75v10.5c0 .97-.78 1.75-1.75 1.75H5.75C4.78 21 4 20.22 4 19.25V4.75Zm8 0V9h4.25L12 4.75Z"/>
                                </svg>
                            </span>
                            <h2 class="h5">{{ plan.title|trans }}</h2>
                            <p class="h4 mb-3">{{ plan.price|trans }}</p>
                            <p class="mb-2">{{ plan.storage|trans }}</p>
                            <p class="mb-2">{{ plan.devices|trans }}</p>
                            <p class="text-secondary small flex-grow-1">{{ plan.description|trans }}</p>
                            <a class="btn btn-primary w-100" href="{{ plan.href|link }}">Выбрать тариф</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </section>

        <section class="storage-panel-grid">
            <div class="storage-panel">
                <div class="storage-panel-head">
                    <h2>Мои услуги</h2>
                    <a class="btn btn-sm btn-outline-primary" href="{{ 'order/service'|link }}">Открыть</a>
                </div>
                <p class="mb-2">Активные услуги: <strong>{{ dashboard.orders.active }}</strong></p>
                <p class="mb-0 text-secondary">После оплаты доступ и инструкции отправляются на email.</p>
            </div>

            <div class="storage-panel">
                <div class="storage-panel-head">
                    <h2>Счета</h2>
                    <a class="btn btn-sm btn-outline-primary" href="{{ 'invoice'|link }}">Открыть</a>
                </div>
                <p class="mb-2">Неоплаченные счета: <strong>{{ dashboard.invoices.unpaid }}</strong></p>
                <p class="mb-0 text-secondary">Счета можно проверить и оплатить в этом разделе.</p>
            </div>
        </section>

        {% if dashboard.recent_orders %}
            <section class="card mt-3">
                <div class="card-header">
                    <h2 class="h6 m-0">Последние услуги</h2>
                </div>
                <div class="list-group list-group-flush">
                    {% for i, order in dashboard.recent_orders %}
                        <a href="{{ 'order/service/manage'|link }}/{{ order.id }}" class="list-group-item d-flex justify-content-between align-items-center">
                            <span>#{{ order.id }} {{ order.title|truncate(45) }}</span>
                            <span class="badge {% if order.status == 'active' %}text-bg-success{% elseif order.status == 'pending_setup' %}text-bg-warning{% elseif order.status == 'failed_setup' or order.status == 'suspended' or order.status == 'failed_renew' %}text-bg-danger{% elseif order.status == 'canceled' %}text-bg-secondary{% endif %}">{{ mf.status_name(order.status) }}</span>
                        </a>
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    {% else %}
        <section class="storage-hero mb-4">
            <div class="storage-hero-copy">
                <span class="storage-kicker">My Storage</span>
                <h1 class="mb-2">Личное облачное хранилище</h1>
                <p class="text-secondary mb-0">Храните документы, фотографии и важные файлы в личном облачном пространстве. Зарегистрируйтесь, выберите тариф и оплатите онлайн.</p>
            </div>
            <div class="storage-hero-panel" aria-label="Storage summary">
                <div class="storage-folder-icon" aria-hidden="true"></div>
                <strong>Защищенный доступ</strong>
                <span>Инструкции приходят на зарегистрированный email после оплаты.</span>
            </div>
        </section>

        <section class="row mb-4">
            {% for plan in storage_plans %}
                <div class="col-md-4 mb-3">
                    <div class="card h-100 storage-plan-card">
                        <div class="card-body d-flex flex-column">
                            <span class="storage-card-icon" aria-hidden="true">
                                <svg class="svg-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                    <path d="M4 4.75C4 3.78 4.78 3 5.75 3h6.5L18 8.75v10.5c0 .97-.78 1.75-1.75 1.75H5.75C4.78 21 4 20.22 4 19.25V4.75Zm8 0V9h4.25L12 4.75Z"/>
                                </svg>
                            </span>
                            <h2 class="h5">{{ plan.title|trans }}</h2>
                            <p class="h4 mb-3">{{ plan.price|trans }}</p>
                            <p class="mb-2">{{ plan.storage|trans }}</p>
                            <p class="mb-2">{{ plan.devices|trans }}</p>
                            <p class="text-secondary small flex-grow-1">{{ plan.description|trans }}</p>
                            <a class="btn btn-primary w-100" href="{{ plan.href|link }}">Выбрать тариф</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </section>

        <section class="storage-panel storage-process">
            <div class="storage-panel-head">
                <h2>Как это работает</h2>
            </div>
                <ol class="mb-0">
                    <li>Создайте аккаунт по email.</li>
                    <li>Выберите один из трех тарифов хранения.</li>
                    <li>Оплатите счет онлайн.</li>
                    <li>Получите инструкции по доступу на email.</li>
                </ol>
        </section>
    {% endif %}
{% endblock %}
