{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ order.title }}{% endblock %}
{% block meta_description %}{% endblock %}
{% block shell_description %}{% endblock %}

{% set addons = client.order_addons({ "id": order.id }) %}

{% block body_class %}order-manage{% endblock %}
{% block breadcrumb %}
<li class="breadcrumb-item"><a href="{{ 'order/service' | link}}">{{ 'Services'|trans }}</a></li>
<li class="breadcrumb-item active" aria-current="page">{{ order.title }}</li>
{% endblock %}

{% set service_partial = "mod_service" ~ order.service_type ~ "_manage.html.twig" %}
{% set upgradables = client.order_upgradables({ 'id': order.id }) %}
{% set orchestrator_access = client.orchestrator_access({ 'order_id': order.id }) %}

{% block content %}
    <div class="row">
        <div class="col-md-12">
            {# Order info #}
            <div class="card mb-4">
                <div class="card-header py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="mb-1">{{ 'Service Details'|trans }}</h1>
                            <span class="small text-secondary">{{ 'All information about your service'|trans }}</span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <table class="table table-hover table-bordered table-sm">
                        <tbody>
                        <tr>
                            <td><label>{{ 'Order'|trans }}</label></td>
                            <td>#{{ order.id }}</td>
                        </tr>

                        <tr>
                            <td><label>{{ 'Product name'|trans }}</label></td>
                            <td><strong>{{ order.title }}</strong></td>
                        </tr>

                        <tr>
                            <td><label>{{ 'Payment amount'|trans }}</label></td>
                            <td>{{ order.total|money(order.currency) }}</td>
                        </tr>

                        {% if order.period %}
                            <tr>
                                <td><label>{{ 'Billing cycle'|trans }}</label></td>
                                <td>{{ order.period|period_title }}</td>
                            </tr>
                        {% endif %}

                        <tr>
                            <td><label>{{ 'Order status'|trans }}</label></td>
                            <td>
                                <span class="badge {% if order.status == 'active' %}text-bg-success{% elseif order.status == 'pending_setup' %}text-bg-warning{% elseif order.status == 'failed_setup' or order.status == 'suspended' or order.status == 'failed_renew' %}text-bg-danger{% elseif order.status == 'canceled' %}text-bg-secondary{% endif %}">{{ mf.status_name(order.status) }}</span>
                            </td>
                        </tr>

                        <tr>
                            <td><label>{{ 'Order created'|trans }}</label></td>
                            <td>{{ order.created_at|format_date }}</td>
                        </tr>

                        <tr>
                            <td><label>{{ 'Activated at'|trans }}</label></td>
                            <td>{% if order.activated_at %}{{ order.activated_at|format_date }}{% else %}-{% endif %}</td>
                        </tr>

                        {% if order.period %}
                            <tr>
                                <td><label>{{ 'Renewal date'|trans }} {% if order.expires_at %} in {{ order.expires_at|daysleft }} day(s) {% endif %}</label></td>
                                <td>{% if order.expires_at %}{{ order.expires_at|format_date }}{% else %}-{% endif %}</td>
                            </tr>
                        {% endif %}

                        {% if order.notes %}
                            <tr>
                                <td><label>{{ 'Order notes'|trans }}</label></td>
                                <td>{{ order.notes|markdown }}</td>
                            </tr>
                        {% endif %}

                        {% if order.active_tickets > 0 %}
                            <tr>
                                <td><label>{{ 'Support'|trans }}</label></td>
                                <td>
                                    <a href="{{ '/contacts'|link }}">{{ 'Contact support'|trans }}</a>
                                </td>
                            </tr>
                        {% endif %}
                        </tbody>
                    </table>
                </div>
                <div class="card-footer">
                    {% if order.period and order.status != 'failed_renew' %}
                        <button class="btn btn-primary btn-sm" type="button" id="renewal-button">{{ 'Renew now'|trans }}</button>
                    {% endif %}
                    <a class="btn btn-outline-primary btn-sm" href="{{ '/contacts'|link }}">{{ 'Contact support'|trans }}</a>
                </div>
            </div>

            {% if orchestrator_access.subscription_link or orchestrator_access.status or orchestrator_access.error %}
                <div class="card mb-4">
                    <div class="card-header py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h1 class="mb-1">Доступ к подключению</h1>
                                <span class="small text-secondary">Ссылка подписки для вашего приложения</span>
                            </div>
                            {% if orchestrator_access.status == 'active' %}
                                <span class="badge text-bg-success text-uppercase">{{ orchestrator_access.status }}</span>
                            {% elseif orchestrator_access.status == 'failed' %}
                                <span class="badge text-bg-danger text-uppercase">{{ orchestrator_access.status }}</span>
                            {% elseif orchestrator_access.status == 'pending' or orchestrator_access.status == 'provisioning' %}
                                <span class="badge text-bg-warning text-uppercase">{{ orchestrator_access.status }}</span>
                            {% elseif orchestrator_access.status %}
                                <span class="badge text-bg-secondary text-uppercase">{{ orchestrator_access.status }}</span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="card-body">
                        {% if orchestrator_access.status == 'pending' or orchestrator_access.status == 'provisioning' %}
                            <p class="mb-3">{{ 'Your access is being prepared. This usually takes a moment.'|trans }}</p>
                        {% elseif orchestrator_access.status == 'failed' %}
                            <div class="alert alert-danger mb-3">
                                {{ 'Provisioning failed. Please contact support if this status does not change soon.'|trans }}
                            </div>
                        {% endif %}
                        {% if orchestrator_access.error %}
                            <div class="alert alert-warning mb-3">
                                <strong>{{ 'Last error'|trans }}:</strong> {{ orchestrator_access.error }}
                            </div>
                        {% endif %}
                        <p class="mb-3">Используйте эту ссылку, чтобы импортировать или обновить подписку в вашем VPN-приложении.</p>
                        {% if orchestrator_access.subscription_link %}
                        <div class="input-group">
                            <input class="form-control" type="text" value="{{ orchestrator_access.subscription_link }}" readonly onclick="this.select();">
                            <a class="btn btn-primary" href="{{ orchestrator_access.subscription_link }}" target="_blank" rel="noopener noreferrer">Открыть ссылку</a>
                        </div>
                        {% endif %}
                        <div class="small text-secondary mt-3">
                            {% if orchestrator_access.last_sync_at %}
                                <div>Последнее обновление: {{ orchestrator_access.last_sync_at|format_date }}</div>
                            {% endif %}
                            {% if orchestrator_access.access_email_sent_at %}
                                <div>Письмо с доступом отправлено: {{ orchestrator_access.access_email_sent_at|format_date }}</div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}

            {# Service management #}
            {% if guest.system_template_exists({ 'file': service_partial }) %}
                {% set service = client.order_service({ 'id': order.id }) %}
                {{ include(service_partial, { 'order': order, 'service': service }) }}
            {% endif %}

            {# Order addons #}
            {% if order.group_master == 1 and addons|length > 0 %}
            <div class="card mb-4">
                <div class="card-header py-3 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="mb-1">{{ 'Addons'|trans }}</h1>
                            <span class="small text-secondary">{{ 'Addons you have ordered with this service'|trans }}</span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                        <table class="table table-hover table-bordered table-sm">
                            <thead>
                            <tr>
                                <th>{{ 'Product/Service'|trans }}</th>
                                <th>{{ 'Price'|trans }}</th>
                                <th>{{ 'Billing Cycle'|trans }}</th>
                                <th>{{ 'Next due date'|trans }}</th>
                                <th>{{ 'Status'|trans }}</th>
                                <th>{{ 'Actions'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for i, addon in addons %}
                                <tr>
                                    <td>{{ addon.title }}</td>
                                    <td>{{ addon.total|money(addon.currency) }}</td>
                                    <td>{{ addon.period|period_title }}</td>
                                    <td>{% if addon.expires_at %}{{ addon.expires_at|format_date }}{% else %}-{% endif %}</td>
                                    <td>
                                        <span class="badge {% if addon.status == 'active' %}text-bg-success{% elseif addon.status == 'pending_setup' %}text-bg-warning{% endif %}">{{ mf.status_name(addon.status) }}</span>
                                    </td>
                                    <td class="actions">
                                        <a class="btn btn-outline-primary btn-sm" href="{{ '/order/service/manage'|link }}/{{ addon.id }}">{{ 'Manage'|trans }}</a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}

        </div>
    </div>

{% endblock %}
{% block js %}
{% autoescape "js" %}
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const renewalButton = document.getElementById('renewal-button');
            if (renewalButton) {
                renewalButton.addEventListener('click', function (event) {
                    event.preventDefault();

                    if (confirm("This will generate new invoice. Are you sure you want to continue?")) {
                        API.client.post('invoice/renewal_invoice', { order_id: {{ order.id }} },
                            (result) => {
                                window.location = "{{ 'invoice'|link }}" + '/' + result;
                            });
                    }
                });
            }
        });
    </script>
{% endautoescape %}
{% endblock %}
