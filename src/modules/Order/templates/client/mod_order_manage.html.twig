{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% import "macro_functions.html.twig" as mf %}

{% set current_locale = guest.system_locale|default(settings.locale|default('ru_RU')) %}
{% set is_en = current_locale starts with 'en' %}
{% set addons = client.order_addons({ "id": order.id }) %}
{% set service_partial = "mod_service" ~ order.service_type ~ "_manage.html.twig" %}
{% set orchestrator_access = client.orchestrator_access({ 'order_id': order.id }) %}
{% set appbridge = client.appbridge_bundle %}
{% set appbridge_unlimited = appbridge.devices.is_unlimited_test_mode|default(false) %}
{% set appbridge_groups = appbridge.devices.groups|default([]) %}
{% set order_appbridge_groups = appbridge_groups|filter(group => group.order_id == order.id) %}
{% set android_apk_url = 'downloads/znet-android-0.1.0-399ee74.apk' | asset_url %}
{% set android_apk_version = '0.1.0' %}
{% set android_apk_build = '399ee74' %}
{% set android_apk_size = '54.1 MB' %}

{% block meta_title %}{{ is_en ? 'Connection' : 'Подключение' }} · {{ order.title }}{% endblock %}
{% block meta_description %}{% endblock %}
{% block shell_title %}{{ is_en ? 'Connection' : 'Подключение' }}{% endblock %}
{% block shell_description %}{% endblock %}

{% block body_class %}order-manage{% endblock %}
{% block breadcrumb %}
<li class="breadcrumb-item"><a href="{{ 'order/service' | link}}">{{ is_en ? 'Connection' : 'Подключение' }}</a></li>
<li class="breadcrumb-item active" aria-current="page">{{ order.title }}</li>
{% endblock %}

{% block content %}
    <section class="znet-shell-section">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                    <div>
                        <h1 class="h3 mb-2">{{ order.title }}</h1>
                        <p class="text-secondary mb-0">
                            {{ is_en
                                ? 'Everything needed to connect is on this page.'
                                : 'Все, что нужно для подключения, находится на этой странице.' }}
                        </p>
                    </div>

                    <span class="badge {% if order.status == 'active' %}text-bg-success{% elseif order.status == 'pending_setup' %}text-bg-warning{% elseif order.status == 'failed_setup' or order.status == 'suspended' or order.status == 'failed_renew' %}text-bg-danger{% elseif order.status == 'canceled' %}text-bg-secondary{% else %}text-bg-secondary{% endif %}">
                        {{ mf.status_name(order.status) }}
                    </span>
                </div>

                <div class="znet-shell-stat-grid mt-4">
                    <article class="znet-shell-stat">
                        <span>{{ is_en ? 'Status' : 'Статус' }}</span>
                        <strong>{{ mf.status_name(order.status) }}</strong>
                    </article>
                    <article class="znet-shell-stat">
                        <span>{{ is_en ? 'Paid through' : 'Оплачен до' }}</span>
                        <strong>{% if order.expires_at %}{{ mf.compact_datetime(order.expires_at) }}{% else %}-{% endif %}</strong>
                    </article>
                    <article class="znet-shell-stat">
                        <span>{{ is_en ? 'Plan price' : 'Стоимость' }}</span>
                        <strong>{{ order.total|money(order.currency) }}</strong>
                    </article>
                </div>

                <div class="znet-shell-link-row mt-4">
                    {% if order.period and order.status != 'failed_renew' %}
                        <button class="btn btn-primary" type="button" id="renewal-button">{{ is_en ? 'Renew' : 'Продлить' }}</button>
                    {% endif %}
                    <a class="btn btn-outline-primary" href="{{ '/contacts'|link }}">{{ is_en ? 'Contact support' : 'Написать в поддержку' }}</a>
                    <a class="btn btn-outline-primary" href="{{ 'order/service'|link }}">{{ is_en ? 'Connection list' : 'Все подключения' }}</a>
                </div>
            </div>
        </div>
    </section>

    <section class="znet-shell-section">
        <div class="znet-shell-section-head">
            <div>
                <h2>{{ is_en ? 'How to connect' : 'Как подключиться' }}</h2>
                <p>
                    {{ is_en
                        ? 'Android has the full Znet app experience. iPhone and iPad use one compatible-client profile with a subscription link.'
                        : 'На Android доступен полный сценарий через приложение Znet. Для iPhone и iPad используется один профиль совместимого клиента со ссылкой подписки.' }}
                </p>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                {% if orchestrator_access.status == 'pending' or orchestrator_access.status == 'provisioning' %}
                    <div class="znet-shell-inline-note mb-3">
                        {{ is_en ? 'Access is being prepared. Usually it takes less than a minute.' : 'Доступ готовится. Обычно это занимает меньше минуты.' }}
                    </div>
                {% elseif orchestrator_access.status == 'failed' %}
                    <div class="alert alert-warning mb-3">
                        {{ is_en ? 'Access was not prepared automatically. Please contact support.' : 'Доступ не подготовился автоматически. Напишите в поддержку.' }}
                    </div>
                {% endif %}

                {% if orchestrator_access.error %}
                    <div class="alert alert-warning mb-3">
                        <strong>{{ is_en ? 'Last error' : 'Последняя ошибка' }}:</strong> {{ orchestrator_access.error }}
                    </div>
                {% endif %}

                {% if orchestrator_access.subscription_link %}
                    <div class="znet-shell-link-row mb-3">
                        <button class="btn btn-outline-primary" type="button" data-znet-copy-subscription>{{ is_en ? 'Copy subscription link' : 'Скопировать ссылку' }}</button>
                    </div>
                {% endif %}

                {% if orchestrator_access.subscription_link %}
                    <label class="form-label" for="znet-subscription-link">{{ is_en ? 'Subscription link' : 'Ссылка подписки' }}</label>
                    <div class="input-group">
                        <input class="form-control" id="znet-subscription-link" type="text" value="{{ orchestrator_access.subscription_link }}" readonly onclick="this.select();">
                        <button class="btn btn-outline-primary" type="button" data-znet-copy-subscription>{{ is_en ? 'Copy' : 'Скопировать' }}</button>
                        <a class="btn btn-primary" href="{{ orchestrator_access.subscription_link }}" target="_blank" rel="noopener noreferrer">{{ is_en ? 'Open' : 'Открыть' }}</a>
                    </div>
                {% else %}
                    <p class="text-secondary mb-0">
                        {{ is_en ? 'The subscription link will appear here after activation.' : 'Ссылка подписки появится здесь после активации.' }}
                    </p>
                {% endif %}
            </div>
        </div>

        <div class="znet-platform-list">
            <details class="znet-platform-card">
                <summary class="znet-platform-summary">
                    <span class="znet-platform-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M8 5 6.4 2.8M16 5l1.6-2.2" />
                            <path d="M7 9h10v8a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V9Z" />
                            <path d="M6 11H4v5h2M18 11h2v5h-2M10 12h.01M14 12h.01" />
                        </svg>
                    </span>
                    <span class="znet-platform-title">Android</span>
                    <span class="znet-platform-summary-note">{{ is_en ? 'Znet app' : 'Приложение Znet' }}</span>
                </summary>
                <div class="znet-platform-body">
                    <h3 class="h4 mb-2">{{ is_en ? 'Install Znet app' : 'Установите приложение Znet' }}</h3>
                    <p class="text-secondary">
                        {{ is_en
                            ? 'This is the recommended option. It enables simple sign-in, device binding, and Auto ON/OFF.'
                            : 'Это основной вариант. Он дает простой вход, привязку устройства и Auto ON/OFF.' }}
                    </p>

                    <div class="znet-shell-link-row">
                        <a class="btn btn-primary" href="{{ android_apk_url }}" download>{{ is_en ? 'Download APK' : 'Скачать APK' }}</a>
                        <span class="text-secondary small">v{{ android_apk_version }} · build {{ android_apk_build }} · {{ android_apk_size }}</span>
                    </div>

                    <details class="znet-app-install-guide mt-3">
                        <summary>{{ is_en ? 'Short setup guide' : 'Короткая инструкция' }}</summary>
                        {% if is_en %}
                            <ol>
                                <li>Open this page on your Android phone.</li>
                                <li>Download and install the APK.</li>
                                <li>Launch Znet.</li>
                                <li>Create a device token below and paste it into the app.</li>
                                <li>Allow VPN connection and notifications.</li>
                                <li>For Auto ON/OFF, enable Activity access in Znet settings. If Android blocks restricted settings, open Znet app info, use the three-dot menu, allow restricted settings, then enable Activity access.</li>
                            </ol>
                        {% else %}
                            <ol>
                                <li>Откройте эту страницу на телефоне Android.</li>
                                <li>Скачайте и установите APK.</li>
                                <li>Запустите Znet.</li>
                                <li>Создайте токен устройства ниже и вставьте его в приложение.</li>
                                <li>Разрешите VPN-подключение и уведомления.</li>
                                <li>Для Auto ON/OFF включите доступ к активности в настройках Znet. Если Android блокирует ограниченные настройки, откройте карточку приложения Znet, нажмите меню с тремя точками, разрешите ограниченные настройки и включите доступ к активности.</li>
                            </ol>
                        {% endif %}
                    </details>

                    {% if not appbridge.has_active_access %}
                        <p class="znet-shell-inline-note mt-3 mb-0">
                            {{ is_en
                                ? 'Device tokens will become available after the service is fully activated.'
                                : 'Токены устройств появятся после полной активации услуги.' }}
                        </p>
                    {% elseif order_appbridge_groups is empty %}
                        <p class="znet-shell-inline-note mt-3 mb-0">
                            {{ is_en
                                ? 'Device activation for this service is being prepared.'
                                : 'Активация устройств для этой услуги готовится.' }}
                        </p>
                    {% else %}
                        {% for group in order_appbridge_groups %}
                            <section class="mt-3" data-appbridge-order="{{ group.order_id }}">
                                <div class="znet-appbridge-stats">
                                    <article class="znet-appbridge-stat">
                                        <span>{{ is_en ? 'Devices' : 'Устройства' }}</span>
                                        <strong data-appbridge-order-device-ratio>{{ group.active }}/{{ appbridge_unlimited and group.eligible_for_app ? '∞' : group.device_limit }}</strong>
                                    </article>
                                    <article class="znet-appbridge-stat">
                                        <span>{{ is_en ? 'Pending tokens' : 'Ожидают активации' }}</span>
                                        <strong data-appbridge-order-pending>{{ group.pending_tokens }}</strong>
                                    </article>
                                </div>

                                <div class="znet-shell-link-row mt-3">
                                    <button
                                        class="btn btn-primary"
                                        type="button"
                                        data-appbridge-add-device
                                        data-order-id="{{ group.order_id }}"
                                        {% if not group.eligible_for_app or (group.pending_tokens|default(0) < 1 and not appbridge_unlimited and group.available < 1) %}disabled{% endif %}
                                    >
                                        {{ is_en ? 'Get device token' : 'Получить токен' }}
                                    </button>
                                    <button
                                        class="btn btn-outline-primary"
                                        type="button"
                                        data-appbridge-open-token
                                        data-order-id="{{ group.order_id }}"
                                        {% if group.pending_tokens|default(0) < 1 %}hidden{% endif %}
                                        {% if not group.eligible_for_app or group.pending_tokens|default(0) < 1 %}disabled{% endif %}
                                    >
                                        {{ is_en ? 'Show token' : 'Показать токен' }}
                                    </button>
                                </div>

                                <details class="znet-app-install-guide mt-3">
                                    <summary>{{ is_en ? 'Connected devices' : 'Подключенные устройства' }}</summary>
                                    <div class="znet-appbridge-device-list mt-3">
                                        {% if group.devices is empty %}
                                            <article class="znet-appbridge-device znet-appbridge-device-empty">
                                                <div>
                                                    <strong>{{ is_en ? 'No devices yet' : 'Устройств пока нет' }}</strong>
                                                    <p class="mb-0 text-secondary small">
                                                        {{ is_en
                                                            ? 'Create a token and paste it into the Znet app.'
                                                            : 'Создайте токен и вставьте его в приложение Znet.' }}
                                                    </p>
                                                </div>
                                            </article>
                                        {% else %}
                                            {% for device in group.devices %}
                                                {% set device_meta = [] %}
                                                {% if device.platform %}{% set device_meta = device_meta|merge([device.platform]) %}{% endif %}
                                                <article class="znet-appbridge-device" data-appbridge-device-row data-device-id="{{ device.id }}">
                                                    <div class="znet-appbridge-device-copy">
                                                        <strong>{{ device.name ?: ((is_en ? 'Device' : 'Устройство') ~ ' #' ~ device.id) }}</strong>
                                                        <p class="mb-0 text-secondary small">{{ device_meta|join(' • ') }}</p>
                                                        {% if device.last_seen_at %}
                                                            <p class="mb-0 text-secondary small">{{ is_en ? 'Last seen' : 'Последний запрос' }}: {{ mf.compact_datetime(device.last_seen_at) }}</p>
                                                        {% endif %}
                                                    </div>
                                                    <div class="znet-appbridge-device-actions">
                                                        <button class="btn btn-outline-primary" type="button" data-appbridge-revoke data-device-id="{{ device.id }}">
                                                            {{ is_en ? 'Disconnect' : 'Отключить' }}
                                                        </button>
                                                    </div>
                                                </article>
                                            {% endfor %}
                                        {% endif %}
                                    </div>
                                </details>
                            </section>
                        {% endfor %}
                    {% endif %}
                </div>
            </details>

            <details class="znet-platform-card">
                <summary class="znet-platform-summary">
                    <span class="znet-platform-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M9 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" />
                            <path d="M11 6h2M11.5 18h1" />
                        </svg>
                    </span>
                    <span class="znet-platform-title">iPhone / iPad</span>
                    <span class="znet-platform-summary-note">{{ is_en ? 'Compatible client profile' : 'Профиль совместимого клиента' }}</span>
                </summary>
                <div class="znet-platform-body">
                    <h3 class="h4 mb-2">{{ is_en ? 'Compatible-client profile' : 'Профиль для совместимого клиента' }}</h3>
                    <p class="text-secondary">
                        {{ is_en
                            ? 'The Znet iPhone app is not ready yet. For now, create one subscription profile and add the link to a compatible VPN client on iPhone or iPad. Auto ON/OFF is available only in the Android app.'
                            : 'Приложения Znet для iPhone пока нет. Сейчас создайте один профиль подписки и добавьте ссылку в совместимый VPN-клиент на iPhone или iPad. Auto ON/OFF доступен только в Android-приложении.' }}
                    </p>

                    {% if not appbridge.has_active_access %}
                        <p class="znet-shell-inline-note mb-0">
                            {{ is_en ? 'The iPhone link will become available after the service is activated.' : 'Ссылка для iPhone появится после активации услуги.' }}
                        </p>
                    {% elseif order_appbridge_groups is empty %}
                        <p class="znet-shell-inline-note mb-0">
                            {{ is_en ? 'iPhone link creation is being prepared for this service.' : 'Создание ссылки iPhone для этой услуги готовится.' }}
                        </p>
                    {% else %}
                        {% for group in order_appbridge_groups %}
                            {% set iphone_devices = group.devices|filter(device => (device.platform|default('')|lower) matches '/^(ios|iphone|manual-ios)/') %}
                            <div class="znet-shell-link-row mb-3">
                                <button
                                    class="btn btn-primary"
                                    type="button"
                                    data-appbridge-create-iphone
                                    data-order-id="{{ group.order_id }}"
                                    {% if not group.eligible_for_app %}disabled{% endif %}
                                >
                                    {% if iphone_devices is empty %}
                                        {{ is_en ? 'Create iPhone/iPad profile' : 'Создать профиль iPhone/iPad' }}
                                    {% else %}
                                        {{ is_en ? 'Refresh subscription link' : 'Обновить ссылку подписки' }}
                                    {% endif %}
                                </button>
                            </div>

                            {% if iphone_devices is empty %}
                                <p class="znet-shell-inline-note mb-0">
                                    {{ is_en
                                        ? 'This creates one iPhone/iPad profile for the active service.'
                                        : 'Будет создан один профиль iPhone/iPad для активной услуги.' }}
                                </p>
                            {% else %}
                                {% for device in iphone_devices %}
                                    <article class="znet-appbridge-device mt-3">
                                        <div class="znet-appbridge-device-copy">
                                            <strong>{{ is_en ? 'iPhone/iPad profile' : 'Профиль iPhone/iPad' }}</strong>
                                            {% if device.subscription_link %}
                                                <label class="form-label small text-secondary mt-2" for="znet-device-subscription-{{ device.id }}">
                                                    {{ is_en ? 'Subscription link' : 'Ссылка подписки' }}
                                                </label>
                                                <div class="input-group">
                                                    <input class="form-control" id="znet-device-subscription-{{ device.id }}" type="text" value="{{ device.subscription_link }}" readonly onclick="this.select();">
                                                    <button class="btn btn-outline-primary" type="button" data-znet-copy-value="{{ device.subscription_link|e('html_attr') }}">{{ is_en ? 'Copy' : 'Скопировать' }}</button>
                                                    <a class="btn btn-primary" href="{{ device.subscription_link }}" target="_blank" rel="noopener noreferrer">{{ is_en ? 'Open' : 'Открыть' }}</a>
                                                </div>
                                            {% else %}
                                                <p class="mb-0 text-secondary small">
                                                    {{ is_en ? 'The link is being prepared. Refresh this page in a few seconds.' : 'Ссылка готовится. Обновите страницу через несколько секунд.' }}
                                                </p>
                                            {% endif %}
                                            {% if device.config_updated_at %}
                                                <p class="mb-0 text-secondary small">{{ is_en ? 'Updated' : 'Обновлено' }}: {{ mf.compact_datetime(device.config_updated_at) }}</p>
                                            {% endif %}
                                            <p class="mb-0 text-secondary small">
                                                {{ is_en
                                                    ? 'Use this link in a compatible VPN client on iPhone or iPad.'
                                                    : 'Используйте эту ссылку в совместимом VPN-клиенте на iPhone или iPad.' }}
                                            </p>
                                        </div>
                                        <div class="znet-appbridge-device-actions">
                                            <button class="btn btn-outline-primary" type="button" data-appbridge-revoke data-device-id="{{ device.id }}">
                                                {{ is_en ? 'Disconnect' : 'Отключить' }}
                                            </button>
                                        </div>
                                    </article>
                                {% endfor %}
                            {% endif %}

                            <div class="znet-shell-checklist mt-3">
                                <div class="znet-shell-check-item"><span class="znet-check">✓</span><span>{{ is_en ? 'Create and copy the iPhone/iPad subscription link.' : 'Создайте и скопируйте ссылку подписки для iPhone/iPad.' }}</span></div>
                                <div class="znet-shell-check-item"><span class="znet-check">✓</span><span>{{ is_en ? 'Open a compatible VPN client on iPhone or iPad.' : 'Откройте совместимый VPN-клиент на iPhone или iPad.' }}</span></div>
                                <div class="znet-shell-check-item"><span class="znet-check">✓</span><span>{{ is_en ? 'Import the link as a subscription.' : 'Импортируйте ссылку как подписку.' }}</span></div>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
            </details>

            <details class="znet-platform-card">
                <summary class="znet-platform-summary">
                    <span class="znet-platform-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M3 5.5 10.5 4v7H3V5.5ZM13.5 3.5 21 2v9h-7.5V3.5ZM3 13h7.5v7L3 18.5V13ZM13.5 13H21v9l-7.5-1.5V13Z" />
                        </svg>
                    </span>
                    <span class="znet-platform-title">Windows</span>
                    <span class="znet-platform-summary-note">{{ is_en ? 'In development' : 'В разработке' }}</span>
                </summary>
                <div class="znet-platform-body">
                    <p class="znet-shell-inline-note mb-0">
                        {{ is_en ? 'In development.' : 'В разработке.' }}
                    </p>
                </div>
            </details>

            <details class="znet-platform-card">
                <summary class="znet-platform-summary">
                    <span class="znet-platform-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M5 16h14v4H5v-4Z" />
                            <path d="M8 16v-2a4 4 0 0 1 8 0v2M8 9a8 8 0 0 1 8 0M5 6a12 12 0 0 1 14 0" />
                            <path d="M8 18h.01M11 18h.01" />
                        </svg>
                    </span>
                    <span class="znet-platform-title">Router</span>
                    <span class="znet-platform-summary-note">{{ is_en ? 'OpenWRT + Podkop' : 'OpenWRT + Podkop' }}</span>
                </summary>
                <div class="znet-platform-body">
                    <p class="text-secondary mb-0">
                        {{ is_en
                            ? 'In development. For OpenWRT, install Podkop, add your Znet subscription link, choose the needed apps or domains, then apply the routing rules.'
                            : 'В разработке. Для OpenWRT установите Podkop, добавьте ссылку подписки Znet, выберите нужные приложения или домены и примените правила маршрутизации.' }}
                    </p>
                </div>
            </details>
        </div>
    </section>

    <section class="znet-shell-section">
        <details class="znet-app-install-guide">
            <summary>{{ is_en ? 'Technical details' : 'Технические детали' }}</summary>
            <div class="table-responsive mt-3">
                <table class="table table-hover table-sm">
                    <tbody>
                        <tr>
                            <td>{{ is_en ? 'Order' : 'Заказ' }}</td>
                            <td>#{{ order.id }}</td>
                        </tr>
                        <tr>
                            <td>{{ is_en ? 'Billing cycle' : 'Период оплаты' }}</td>
                            <td>{% if order.period %}{{ order.period|period_title }}{% else %}-{% endif %}</td>
                        </tr>
                        <tr>
                            <td>{{ is_en ? 'Created' : 'Создан' }}</td>
                            <td>{{ mf.compact_datetime(order.created_at) }}</td>
                        </tr>
                        <tr>
                            <td>{{ is_en ? 'Activated' : 'Активирован' }}</td>
                            <td>{% if order.activated_at %}{{ mf.compact_datetime(order.activated_at) }}{% else %}-{% endif %}</td>
                        </tr>
                        {% if orchestrator_access.last_sync_at %}
                            <tr>
                                <td>{{ is_en ? 'Last access update' : 'Последнее обновление доступа' }}</td>
                                <td>{{ mf.compact_datetime(orchestrator_access.last_sync_at) }}</td>
                            </tr>
                        {% endif %}
                        {% if orchestrator_access.access_email_sent_at %}
                            <tr>
                                <td>{{ is_en ? 'Access email sent' : 'Письмо с доступом отправлено' }}</td>
                                <td>{{ mf.compact_datetime(orchestrator_access.access_email_sent_at) }}</td>
                            </tr>
                        {% endif %}
                        {% if order.notes %}
                            <tr>
                                <td>{{ is_en ? 'Notes' : 'Заметки' }}</td>
                                <td>{{ order.notes|markdown }}</td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>

            {% if order.group_master == 1 and addons|length > 0 %}
                <div class="table-responsive mt-3">
                    <table class="table table-hover table-sm">
                        <thead>
                        <tr>
                            <th>{{ 'Product/Service'|trans }}</th>
                            <th>{{ 'Price'|trans }}</th>
                            <th>{{ 'Status'|trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for i, addon in addons %}
                            <tr>
                                <td>{{ addon.title }}</td>
                                <td>{{ addon.total|money(addon.currency) }}</td>
                                <td>{{ mf.status_name(addon.status) }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

            {% if guest.system_template_exists({ 'file': service_partial }) %}
                {% set service = client.order_service({ 'id': order.id }) %}
                <div class="mt-3">
                    {{ include(service_partial, { 'order': order, 'service': service }) }}
                </div>
            {% endif %}
        </details>
    </section>

    <div class="znet-appbridge-modal" hidden data-appbridge-modal>
        <div class="znet-appbridge-modal-backdrop" data-appbridge-close></div>
        <div class="znet-appbridge-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="appbridge-modal-title">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <h2 class="h5 mb-1" id="appbridge-modal-title">{{ is_en ? 'Device token' : 'Токен устройства' }}</h2>
                            <p class="text-secondary mb-0">
                                {{ is_en
                                    ? 'Copy this token and paste it into the Znet app.'
                                    : 'Скопируйте токен и вставьте его в приложение Znet.' }}
                            </p>
                        </div>

                        <button class="znet-btn znet-btn-ghost znet-btn-icon-only" type="button" data-appbridge-close aria-label="{{ is_en ? 'Close' : 'Закрыть' }}">
                            <svg class="znet-btn-svg-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M6 6l12 12"></path>
                                <path d="M18 6L6 18"></path>
                            </svg>
                        </button>
                    </div>

                    <button class="znet-appbridge-token-field" type="button" data-appbridge-token-copy>
                        <span data-appbridge-token>••••••••••••••••••••••••••••••••</span>
                    </button>

                    <div class="znet-shell-link-row mt-3">
                        <button class="btn btn-primary" type="button" data-appbridge-copy-btn>{{ is_en ? 'Copy token' : 'Скопировать токен' }}</button>
                        <button class="btn btn-outline-primary" type="button" data-appbridge-rotate-btn>{{ is_en ? 'Create new token' : 'Создать новый токен' }}</button>
                        <button class="btn btn-outline-primary" type="button" data-appbridge-close>{{ is_en ? 'Close' : 'Закрыть' }}</button>
                    </div>

                    <p class="text-secondary small mt-3 mb-0" data-appbridge-meta>
                        {{ is_en ? 'A new token will appear here after generation.' : 'После создания токен появится здесь.' }}
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block js %}
{% autoescape "js" %}
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const renewalButton = document.getElementById('renewal-button');
            if (renewalButton) {
                renewalButton.addEventListener('click', function (event) {
                    event.preventDefault();

                    if (confirm("{{ is_en ? 'Open renewal payment?' : 'Открыть оплату продления?' }}")) {
                        API.client.post('invoice/renewal_invoice', { order_id: {{ order.id }} },
                            (result) => {
                                window.location = "{{ 'invoice'|link }}" + '/' + result;
                            });
                    }
                });
            }

            const copyButtons = document.querySelectorAll('[data-znet-copy-subscription]');
            const subscriptionInput = document.getElementById('znet-subscription-link');
            if (copyButtons.length && subscriptionInput) {
                copyButtons.forEach((copyButton) => copyButton.addEventListener('click', async function () {
                    const originalText = copyButton.textContent;
                    subscriptionInput.select();
                    try {
                        await navigator.clipboard.writeText(subscriptionInput.value);
                        copyButton.textContent = "{{ is_en ? 'Copied' : 'Скопировано' }}";
                    } catch (error) {
                        document.execCommand('copy');
                        copyButton.textContent = "{{ is_en ? 'Copied' : 'Скопировано' }}";
                    }
                    window.setTimeout(() => {
                        copyButton.textContent = originalText;
                    }, 1800);
                }));
            }

            document.querySelectorAll('[data-znet-copy-value]').forEach((copyButton) => {
                copyButton.addEventListener('click', async function () {
                    const originalText = copyButton.textContent;
                    const value = copyButton.getAttribute('data-znet-copy-value') || '';
                    if (!value) {
                        return;
                    }

                    try {
                        await navigator.clipboard.writeText(value);
                    } catch (error) {
                        const helper = document.createElement('textarea');
                        helper.value = value;
                        document.body.appendChild(helper);
                        helper.select();
                        document.execCommand('copy');
                        document.body.removeChild(helper);
                    }

                    copyButton.textContent = "{{ is_en ? 'Copied' : 'Скопировано' }}";
                    window.setTimeout(() => {
                        copyButton.textContent = originalText;
                    }, 1800);
                });
            });
        });
    </script>
{% endautoescape %}
{% include 'partial_appbridge_client_area_js.html.twig' %}
{% endblock %}
