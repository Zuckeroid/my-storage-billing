{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% import "macro_functions.html.twig" as mf %}

{% set current_locale = guest.system_locale|default(settings.locale|default('ru_RU')) %}
{% set is_en = current_locale starts with 'en' %}

{% block meta_title %}{{ is_en ? 'Connection' : 'Подключение' }}{% endblock %}
{% block meta_description %}{% endblock %}
{% block shell_title %}{{ is_en ? 'Connection' : 'Подключение' }}{% endblock %}
{% block shell_description %}{% endblock %}

{% block body_class %}order-list{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">{{ is_en ? 'Connection' : 'Подключение' }}</li>
{% endblock %}

{% block content %}
    {% set orders = client.order_get_list({"per_page":10, "page":request.page, "hide_addons":1}) %}

    <section class="znet-shell-section">
        {% if orders.list %}
            <div class="znet-service-card-list">
                {% for order in orders.list %}
                    <article class="znet-service-card">
                        <div class="znet-service-card-main">
                            <span class="badge {% if order.status == 'active' %}text-bg-success{% elseif order.status == 'pending_setup' %}text-bg-warning{% elseif order.status == 'failed_setup' or order.status == 'suspended' or order.status == 'failed_renew' %}text-bg-danger{% elseif order.status == 'canceled' %}text-bg-secondary{% else %}text-bg-secondary{% endif %}">
                                {{ mf.status_name(order.status) }}
                            </span>
                            <h2>{{ order.title }}</h2>
                            <p>
                                {% if order.expires_at %}
                                    {{ is_en ? 'Paid through' : 'Оплачен до' }} {{ mf.compact_datetime(order.expires_at) }}
                                {% else %}
                                    {{ is_en ? 'No expiration date yet' : 'Дата окончания пока не назначена' }}
                                {% endif %}
                            </p>
                        </div>
                        <div class="znet-service-card-actions">
                            <a class="znet-btn znet-btn-accent" href="{{ '/order/service/manage'|link }}/{{ order.id }}">
                                {{ is_en ? 'Open connection' : 'Открыть подключение' }}
                            </a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% else %}
            <div class="znet-shell-empty-state znet-service-empty">
                <span>{{ is_en ? 'No active connection yet' : 'Подключение пока не оформлено' }}</span>
                <a class="znet-btn znet-btn-accent" href="{{ 'invoice'|link }}#plans">{{ is_en ? 'Choose plan' : 'Выбрать тариф' }}</a>
            </div>
        {% endif %}

        {{ include('partial_pagination.html.twig', { 'list': orders }) }}
    </section>
{% endblock %}
