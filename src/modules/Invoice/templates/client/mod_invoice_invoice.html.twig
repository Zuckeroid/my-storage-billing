{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% import "macro_functions.html.twig" as mf %}

{% set current_locale = guest.system_locale|default(settings.locale|default('ru_RU')) %}
{% set is_en = current_locale starts with 'en' %}
{% set nr = invoice.serie ~ "%05s"|format(invoice.nr) %}
{% set seller = invoice.seller %}
{% set buyer = invoice.buyer %}
{% set invoice_status_class = invoice.status == 'paid' ? 'text-bg-success' : (invoice.status == 'unpaid' ? 'text-bg-warning' : (invoice.status == 'canceled' ? 'text-bg-secondary' : 'text-bg-danger')) %}

{% block meta_title %}{{ is_en ? 'Invoice' : 'Счет' }} #{{ nr }}{% endblock %}
{% block meta_description %}{% endblock %}
{% block shell_title %}{{ is_en ? 'Invoice' : 'Счет' }} #{{ nr }}{% endblock %}
{% block shell_description %}{% endblock %}
{% block body_class %}invoice-invoice{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ '/invoice'|link }}">{{ is_en ? 'Invoices' : 'Счета' }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">#{{ nr }}</li>
{% endblock %}

{% block content %}
    <section class="znet-shell-section">
        <div class="znet-invoice-hero">
            <div class="znet-invoice-hero-main">
                <span class="badge {{ invoice_status_class }}">{{ mf.status_name(invoice.status) }}</span>
                <h2>{{ is_en ? 'Invoice' : 'Счет' }} #{{ nr }}</h2>
                {% if invoice.status == 'unpaid' %}
                    <p>{{ is_en ? 'Choose a payment method below. After payment, the service status will update automatically.' : 'Выберите способ оплаты ниже. После оплаты статус услуги обновится автоматически.' }}</p>
                {% elseif invoice.status == 'paid' %}
                    <p>{{ is_en ? 'Payment has been received. You can return to your services or keep this invoice for your records.' : 'Оплата получена. Можно вернуться к услугам или сохранить счет для истории.' }}</p>
                {% else %}
                    <p>{{ is_en ? 'This invoice is not waiting for payment.' : 'Этот счет сейчас не ожидает оплаты.' }}</p>
                {% endif %}
            </div>
            <div class="znet-invoice-hero-total">
                <span>{{ is_en ? 'Total' : 'Сумма' }}</span>
                <strong>{{ invoice.total | money(invoice.currency) }}</strong>
            </div>
        </div>

        <div class="znet-shell-stat-grid">
            <article class="znet-shell-stat">
                <div class="znet-shell-stat-line">
                    <span>{{ is_en ? 'Created' : 'Создан' }}</span>
                    <strong>
                        {% if invoice.created_at|trim %}
                            {{ invoice.created_at|format_date }}
                        {% else %}
                            -
                        {% endif %}
                    </strong>
                </div>
            </article>
            <article class="znet-shell-stat">
                <div class="znet-shell-stat-line">
                    <span>
                        {% if invoice.paid_at|trim %}
                            {{ is_en ? 'Paid' : 'Оплачен' }}
                        {% else %}
                            {{ is_en ? 'Due date' : 'Срок оплаты' }}
                        {% endif %}
                    </span>
                    <strong>
                        {% if invoice.paid_at|trim %}
                            {{ invoice.paid_at|format_date }}
                        {% elseif invoice.due_at|trim %}
                            {{ invoice.due_at|format_date }}
                        {% else %}
                            -
                        {% endif %}
                    </strong>
                </div>
            </article>
            <article class="znet-shell-stat">
                <div class="znet-shell-stat-line">
                    <span>{{ is_en ? 'Status' : 'Статус' }}</span>
                    <strong>{{ mf.status_name(invoice.status) }}</strong>
                </div>
            </article>
        </div>
    </section>

    {% if invoice.status == 'unpaid' %}
        <section class="znet-shell-section">
            <div class="znet-shell-section-head">
                <div>
                    <h2>{{ is_en ? 'Payment' : 'Оплата' }}</h2>
                </div>
            </div>

            <div class="znet-invoice-gateway-grid">
                {% for gtw in guest.invoice_gateways %}
                    {% if invoice.currency in gtw.accepted_currencies %}
                        <button
                            type="button"
                            class="znet-invoice-gateway"
                            onclick="paymentPrompt('{{ gtw.id }}', {{ gtw.allow_recurrent ? 'true' : 'false' }}, `{{ gtw.title|e('js') }}`)"
                        >
                            <span class="znet-invoice-gateway-logo">
                                {% if gtw.logo.logo|default('') %}
                                    <span
                                        class="znet-invoice-gateway-logo-img"
                                        style="background-image: url('{{ gtw.logo.logo }}');"
                                        aria-hidden="true"
                                    ></span>
                                {% else %}
                                    <span class="znet-invoice-gateway-logo-fallback">{{ gtw.title|first|upper }}</span>
                                {% endif %}
                            </span>
                            <span class="znet-invoice-gateway-copy">
                                <strong>{{ gtw.title }}</strong>
                                <small>{{ is_en ? 'Continue to payment' : 'Перейти к оплате' }}</small>
                            </span>
                        </button>
                    {% endif %}
                {% else %}
                    <div class="znet-shell-empty-state">
                        {{ is_en ? 'No payment methods are available for this invoice.' : 'Для этого счета нет доступных способов оплаты.' }}
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    <section class="znet-shell-section">
        <div class="znet-shell-section-head znet-invoice-section-head">
            <div>
                <h2>{{ is_en ? 'Invoice details' : 'Состав счета' }}</h2>
            </div>
            <div class="znet-invoice-actions">
                <a href="{{ 'invoice/pdf'|link }}/{{ invoice.hash }}" target="_blank" class="znet-btn znet-btn-outline">{{ 'PDF'|trans }}</a>
                <a href="{{ 'invoice/print'|link }}/{{ invoice.hash }}" target="_blank" class="znet-btn znet-btn-outline">{{ is_en ? 'Print' : 'Печать' }}</a>
            </div>
        </div>

        {% if invoice.text_1 %}
            <div class="znet-shell-inline-note">
                {{ invoice.text_1|markdown }}
            </div>
        {% endif %}

        <div class="table-responsive znet-shell-table-wrap">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>{{ '#'|trans }}</th>
                        <th>{{ is_en ? 'Item' : 'Позиция' }}</th>
                        <th>{{ is_en ? 'Price' : 'Цена' }}</th>
                        <th class="text-end">{{ is_en ? 'Total' : 'Итого' }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for i, item in invoice.lines %}
                        <tr>
                            <td>{{ i + 1 }}</td>
                            <td>
                                {% if item.order_id %}
                                    <a href="{{ '/order/service'|link }}/manage/{{ item.order_id }}">{{ item.title }}</a>
                                {% else %}
                                    {{ item.title }}
                                {% endif %}
                                {% if item.quantity > 1 %}
                                    <span class="text-muted">x {{ item.quantity }} {{ item.unit }}</span>
                                {% endif %}
                            </td>
                            <td>{{ item.price | money(invoice.currency) }}</td>
                            <td class="text-end">{{ item.total | money(invoice.currency) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="znet-invoice-summary">
            {% if invoice.tax > 0 %}
                <div class="znet-invoice-summary-row">
                    <span>{{ invoice.taxname }} {{ invoice.taxrate }}%</span>
                    <strong>{{ invoice.tax | money(invoice.currency) }}</strong>
                </div>
            {% endif %}
            {% if invoice.discount > 0 %}
                <div class="znet-invoice-summary-row">
                    <span>{{ 'Discount'|trans }}</span>
                    <strong>{{ invoice.discount | money(invoice.currency) }}</strong>
                </div>
            {% endif %}
            <div class="znet-invoice-summary-row znet-invoice-summary-total">
                <span>{{ is_en ? 'Total' : 'Итого' }}</span>
                <strong>{{ invoice.total | money(invoice.currency) }}</strong>
            </div>
        </div>

        {% if invoice.text_2 %}
            <div class="znet-shell-inline-note">
                {{ invoice.text_2|markdown }}
            </div>
        {% endif %}
    </section>

    <section class="znet-shell-section">
        <div class="znet-shell-card-grid znet-shell-card-grid-2">
            <article class="card znet-invoice-party-card">
                <div class="card-body">
                    <h2>{{ is_en ? 'Seller' : 'Продавец' }}</h2>
                    <dl class="znet-invoice-dl">
                        {% if seller.company|trim %}
                            <dt>{{ is_en ? 'Name' : 'Название' }}</dt>
                            <dd>{{ seller.company }}</dd>
                        {% endif %}
                        {% if seller.company_vat|trim %}
                            <dt>{{ is_en ? 'Tax ID' : 'ИНН' }}</dt>
                            <dd>{{ seller.company_vat }}</dd>
                        {% endif %}
                        {% if seller.address|trim %}
                            <dt>{{ is_en ? 'Address' : 'Адрес' }}</dt>
                            <dd>{{ seller.address }}</dd>
                        {% endif %}
                        {% if seller.phone|trim %}
                            <dt>{{ is_en ? 'Phone' : 'Телефон' }}</dt>
                            <dd>{{ seller.phone }}</dd>
                        {% endif %}
                        {% if seller.email|trim %}
                            <dt>{{ 'Email'|trans }}</dt>
                            <dd>{{ seller.email }}</dd>
                        {% endif %}
                        {% if seller.account_number|trim %}
                            <dt>{{ is_en ? 'Account' : 'Счет' }}</dt>
                            <dd>{{ seller.account_number }}</dd>
                        {% endif %}
                        {% if seller.note|trim %}
                            <dt>{{ is_en ? 'Note' : 'Примечание' }}</dt>
                            <dd>{{ seller.note }}</dd>
                        {% endif %}
                    </dl>
                </div>
            </article>

            <article class="card znet-invoice-party-card">
                <div class="card-body">
                    <h2>{{ is_en ? 'Client' : 'Клиент' }}</h2>
                    <dl class="znet-invoice-dl">
                        {% if buyer.first_name|trim or buyer.last_name|trim %}
                            <dt>{{ is_en ? 'Name' : 'Имя' }}</dt>
                            <dd>{{ buyer.first_name }} {{ buyer.last_name }}</dd>
                        {% endif %}
                        {% if buyer.company|trim %}
                            <dt>{{ is_en ? 'Company' : 'Компания' }}</dt>
                            <dd>{{ buyer.company }}</dd>
                        {% endif %}
                        {% if buyer.company_number|trim %}
                            <dt>{{ is_en ? 'Company number' : 'Номер компании' }}</dt>
                            <dd>{{ buyer.company_number }}</dd>
                        {% endif %}
                        {% if buyer.company_vat|trim %}
                            <dt>{{ is_en ? 'Tax ID' : 'ИНН' }}</dt>
                            <dd>{{ buyer.company_vat }}</dd>
                        {% endif %}
                        {% if buyer.address|trim %}
                            <dt>{{ is_en ? 'Address' : 'Адрес' }}</dt>
                            <dd>{{ buyer.address }}{% if buyer.city or buyer.state %}, {{ buyer.city }} {{ buyer.state }}{% endif %}{% if buyer.zip or buyer.country %}, {{ buyer.zip }} {{ guest.system_countries[buyer.country]|default(buyer.country) }}{% endif %}</dd>
                        {% endif %}
                        {% if buyer.phone|trim %}
                            <dt>{{ is_en ? 'Phone' : 'Телефон' }}</dt>
                            <dd>{{ buyer.phone }}</dd>
                        {% endif %}
                    </dl>
                </div>
            </article>
        </div>
    </section>

    <div class="modal modal-lg fade znet-invoice-modal" id="paymentPrompt" tabindex="-1" aria-labelledby="paymentPromptLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="paymentPromptLabel"></h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ is_en ? 'Close' : 'Закрыть' }}"></button>
                </div>
                <div class="modal-body">
                    <p id="bodyText"></p>
                    <div class="znet-invoice-modal-actions">
                        <a href="#" class="znet-btn znet-btn-accent" id="single">{{ is_en ? 'Pay once' : 'Оплатить один раз' }}</a>
                        <a href="#" class="znet-btn znet-btn-accent" id="subscription" hidden="true">{{ is_en ? 'Pay and create subscription' : 'Оплатить и создать подписку' }}</a>
                        <a href="#" class="znet-btn znet-btn-accent" id="pay-nondescript" hidden="true">{{ is_en ? 'Pay' : 'Оплатить' }}</a>
                        <button type="button" class="znet-btn znet-btn-outline" data-bs-dismiss="modal">{{ is_en ? 'Cancel' : 'Отмена' }}</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block js %}
<script>
    function paymentPrompt(id, supportsSubscription, title) {
        const invoiceHash = "{{ invoice.hash }}";
        const backLink = "{{ 'invoice/banklink'|link }}";
        const paymentLink = new URL(backLink.concat('/', invoiceHash, '/', id), window.location.origin);
        const invoiceSubscribable = {{ invoice.subscribable ? 'true' : 'false' }};

        {% set anyGatewayDoesSubscriptions = false %}
        {% for gtw in guest.invoice_gateways %}
            {% if gtw.allow_recurrent %}
                {% set anyGatewayDoesSubscriptions = true %}
            {% endif %}
        {% endfor %}

        const canAnyGatewayDoSubs = {{ anyGatewayDoesSubscriptions ? 'true' : 'false' }};
        const bodyText = document.getElementById('bodyText');
        const subscription = document.getElementById('subscription');
        const single = document.getElementById('single');
        const payNondescript = document.getElementById('pay-nondescript');

        {% if settings.prompt_subscription %}
            single.hidden = false;
            payNondescript.hidden = true;
            if (supportsSubscription && invoiceSubscribable) {
                bodyText.textContent = `{{ is_en ? 'This invoice and payment method support recurring payments. Choose how you want to continue.' : 'Этот счет и способ оплаты поддерживают регулярные платежи. Выберите, как продолжить.' }}`;
                subscription.hidden = false;
            } else if (!invoiceSubscribable) {
                bodyText.textContent = `{{ is_en ? 'Continue with the selected payment method.' : 'Продолжите оплату выбранным способом.' }}`;
                subscription.hidden = true;
            } else {
                bodyText.textContent = canAnyGatewayDoSubs
                    ? `{{ is_en ? 'Continue with this method or choose another method if you need recurring payments.' : 'Продолжите этим способом или выберите другой, если нужна подписка.' }}`
                    : `{{ is_en ? 'Continue with the selected payment method.' : 'Продолжите оплату выбранным способом.' }}`;
                subscription.hidden = true;
            }
        {% else %}
            bodyText.textContent = `{{ is_en ? 'Continue with the selected payment method.' : 'Продолжите оплату выбранным способом.' }}`;
            subscription.hidden = true;
            single.hidden = true;
            payNondescript.hidden = false;
        {% endif %}

        document.getElementById('paymentPromptLabel').textContent = `{{ is_en ? 'Payment method' : 'Способ оплаты' }}: ${title}`;
        subscription.href = paymentLink.href;
        payNondescript.href = paymentLink.href;
        paymentLink.searchParams.append('allow_subscription', 0);
        single.href = paymentLink.href;

        const modal = new bootstrap.Modal('#paymentPrompt');
        modal.show();
    }
</script>
{% endblock %}
