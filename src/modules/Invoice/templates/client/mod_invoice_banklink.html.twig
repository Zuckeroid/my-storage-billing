{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% set current_locale = guest.system_locale|default(settings.locale|default('ru_RU')) %}
{% set is_en = current_locale starts with 'en' %}

{% block meta_title %}{{ is_en ? 'Opening payment' : 'Открываем оплату' }}{% endblock %}
{% block shell_title %}{{ is_en ? 'Opening payment' : 'Открываем оплату' }}{% endblock %}
{% block shell_description %}{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ '/invoice'|link }}">{{ is_en ? 'Payments' : 'Платежи' }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ is_en ? 'Opening payment' : 'Открываем оплату' }}</li>
{% endblock %}

{% block content %}
    <section class="znet-shell-section">
        <article class="card znet-payment-state-card">
            <div class="card-body">
                <span class="znet-shell-eyebrow">{{ is_en ? 'Payment' : 'Оплата' }}</span>
                <h2>{{ is_en ? 'Redirecting to the payment page' : 'Переходим на страницу оплаты' }}</h2>
                <p class="text-secondary">
                    {{ is_en
                        ? 'If nothing happens automatically, press the button below.'
                        : 'Если переход не начался автоматически, нажмите кнопку ниже.' }}
                </p>

                {% if payment.type == 'html' %}
                    <div class="znet-payment-embedded">
                        {{ payment.result|raw }}
                    </div>
                {% endif %}

                {% if payment.type == 'form' %}
                    <form method="post" action="{{ payment.service_url }}" name="payment_form" class="znet-payment-redirect-form">
                        {% for key, value in payment.result %}
                            <input type="hidden" name="{{ key }}" value="{{ value }}" />
                        {% endfor %}
                        <button class="btn btn-primary" type="submit" id="payment_button">
                            {{ is_en ? 'Continue to payment' : 'Перейти к оплате' }}
                        </button>
                    </form>

                    <script>
                        document.addEventListener('DOMContentLoaded', function() {
                            const button = document.getElementById('payment_button');
                            if (button) {
                                button.style.display = 'none';
                            }
                            document.forms["payment_form"].submit();
                        });
                    </script>
                {% endif %}
            </div>
        </article>
    </section>
{% endblock %}
