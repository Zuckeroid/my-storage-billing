{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% set current_locale = guest.system_locale|default(settings.locale|default('ru_RU')) %}
{% set is_en = current_locale starts with 'en' %}

{% block meta_title %}{{ is_en ? 'Payment accepted' : 'Оплата принята' }}{% endblock %}
{% block shell_title %}{{ is_en ? 'Payment accepted' : 'Оплата принята' }}{% endblock %}
{% block shell_description %}{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active" aria-current="page">{{ is_en ? 'Payment accepted' : 'Оплата принята' }}</li>{% endblock %}

{% block content %}
    <section class="znet-shell-section">
        <article class="card znet-payment-state-card">
            <div class="card-body">
                <span class="znet-shell-eyebrow">{{ is_en ? 'Payment' : 'Оплата' }}</span>
                <h2>{{ is_en ? 'We are checking the payment' : 'Проверяем платеж' }}</h2>
                <p class="text-secondary">
                    {{ is_en
                        ? 'The payment has been submitted. We will update the status automatically as soon as the gateway confirms it.'
                        : 'Платеж отправлен. Мы обновим статус автоматически, как только платежный шлюз подтвердит операцию.' }}
                </p>
                <div class="progress znet-payment-progress">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" style="width: 100%"></div>
                </div>
                <div class="znet-shell-link-row mt-4">
                    <a class="btn btn-primary" href="{{ ('/invoice/' ~ invoice.hash)|link }}">{{ is_en ? 'Open payment' : 'Открыть оплату' }}</a>
                    <a class="btn btn-outline-primary" href="{{ '/order/service'|link }}">{{ is_en ? 'Connection' : 'Подключение' }}</a>
                </div>
            </div>
        </article>
    </section>

    <script>
        setTimeout(function() {
            window.location = "{{ ('/invoice/' ~ invoice.hash)|link }}";
        }, 1 * 60 * 1000);
    </script>
{% endblock %}
