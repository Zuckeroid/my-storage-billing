{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set current_locale = guest.system_locale|default(settings.locale|default('ru_RU')) %}
{% set is_en = current_locale starts with 'en' %}
{% set all_invoices = client.invoice_get_list({"per_page":10, "page":request.page}) %}
{% set visible_all_invoices = all_invoices.list|filter(invoice => invoice.status != 'canceled') %}
{% set unpaid_invoices = client.invoice_get_list({"status":"unpaid", "per_page":10, "page":request.page}) %}
{% set paid_invoices = client.invoice_get_list({"status":"paid", "per_page":10, "page":request.page}) %}
{% set active_tab = request.tab in ['paid', 'unpaid'] ? request.tab : 'all' %}

{% block meta_title %}{{ is_en ? 'Payments' : 'Платежи' }}{% endblock %}
{% block meta_description %}{% endblock %}
{% block shell_title %}{{ is_en ? 'Payments' : 'Платежи' }}{% endblock %}
{% block shell_description %}{% endblock %}

{% block body_class %}invoice-index{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">{{ is_en ? 'Payments' : 'Платежи' }}</li>
{% endblock %}

{% macro invoice_actions(invoice, is_en) %}
    <div class="znet-shell-table-actions">
        {% if invoice.status == 'unpaid' %}
            <a class="znet-btn znet-btn-accent" href="{{ 'invoice'|link }}/{{ invoice.hash }}">{{ is_en ? 'Pay' : 'Оплатить' }}</a>
            <form
                method="post"
                action="{{ 'api/client/invoice/cancel'|link }}"
                class="znet-shell-inline-form"
                onsubmit="return confirm('{{ (is_en ? 'Cancel this payment?' : 'Отменить эту оплату?')|e('js') }}');"
                {{ fb_api_form({reload: true}) }}
            >
                <input type="hidden" name="hash" value="{{ invoice.hash }}">
                <button
                    type="submit"
                    class="znet-btn znet-btn-outline znet-btn-icon-only"
                    aria-label="{{ is_en ? 'Cancel payment' : 'Отменить оплату' }}"
                    title="{{ is_en ? 'Cancel payment' : 'Отменить оплату' }}"
                >
                    <svg class="znet-btn-svg-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 6l12 12"></path>
                        <path d="M18 6L6 18"></path>
                    </svg>
                </button>
            </form>
        {% else %}
            <a href="{{ 'invoice'|link }}/{{ invoice.hash }}" class="znet-btn znet-btn-outline">{{ is_en ? 'View' : 'Открыть' }}</a>
        {% endif %}
    </div>
{% endmacro %}

{% import _self as invoice_ui %}

{% block content %}
    <section class="znet-shell-section">
        <nav class="znet-shell-inline-tabs" aria-label="{{ is_en ? 'Payment filters' : 'Фильтры платежей' }}">
            <a class="znet-shell-inline-tab{% if active_tab == 'all' %} is-active{% endif %}" href="{{ 'invoice'|link }}">
                <span>{{ is_en ? 'All' : 'Все' }}</span>
                {% if visible_all_invoices|length %}
                    <span class="znet-shell-inline-tab-count">{{ visible_all_invoices|length }}</span>
                {% endif %}
            </a>
            <a class="znet-shell-inline-tab{% if active_tab == 'unpaid' %} is-active{% endif %}" href="{{ 'invoice'|link({ tab: 'unpaid' }) }}">
                <span>{{ is_en ? 'To pay' : 'К оплате' }}</span>
                {% if unpaid_invoices.total %}
                    <span class="znet-shell-inline-tab-count">{{ unpaid_invoices.total }}</span>
                {% endif %}
            </a>
            <a class="znet-shell-inline-tab{% if active_tab == 'paid' %} is-active{% endif %}" href="{{ 'invoice'|link({ tab: 'paid' }) }}">
                <span>{{ is_en ? 'Paid' : 'Оплаченные' }}</span>
                {% if paid_invoices.total %}
                    <span class="znet-shell-inline-tab-count">{{ paid_invoices.total }}</span>
                {% endif %}
            </a>
        </nav>

        <div class="table-responsive znet-shell-table-wrap">
            <table class="table table-hover align-middle mb-0">
                <thead>
                {% if active_tab == 'paid' %}
                    <tr>
                        <th>{{ is_en ? 'Payment' : 'Платеж' }}</th>
                        <th>{{ is_en ? 'Created' : 'Создан' }}</th>
                        <th>{{ is_en ? 'Paid' : 'Оплачен' }}</th>
                        <th>{{ is_en ? 'Total' : 'Сумма' }}</th>
                        <th>{{ is_en ? 'Actions' : 'Действия' }}</th>
                    </tr>
                {% elseif active_tab == 'all' %}
                    <tr>
                        <th>{{ is_en ? 'Payment' : 'Платеж' }}</th>
                        <th>{{ is_en ? 'Created' : 'Создан' }}</th>
                        <th>{{ is_en ? 'Status' : 'Статус' }}</th>
                        <th>{{ is_en ? 'Total' : 'Сумма' }}</th>
                        <th>{{ is_en ? 'Actions' : 'Действия' }}</th>
                    </tr>
                {% else %}
                    <tr>
                        <th>{{ is_en ? 'Payment' : 'Платеж' }}</th>
                        <th>{{ is_en ? 'Created' : 'Создан' }}</th>
                        <th>{{ is_en ? 'Due date' : 'Срок оплаты' }}</th>
                        <th>{{ is_en ? 'Total' : 'Сумма' }}</th>
                        <th>{{ is_en ? 'Actions' : 'Действия' }}</th>
                    </tr>
                {% endif %}
                </thead>
                <tbody>
                {% if active_tab == 'paid' %}
                    {% for invoice in paid_invoices.list %}
                        <tr>
                            <td><a href="{{ 'invoice'|link }}/{{ invoice.hash }}">{{ is_en ? 'Payment' : 'Платеж' }} #{{ invoice.serie ~ "%05s"|format(invoice.nr) }}</a></td>
                            <td>{{ invoice.created_at|format_date }}</td>
                            <td>{{ invoice.paid_at|format_date }}</td>
                            <td>{{ invoice.total | money(invoice.currency) }}</td>
                            <td>{{ invoice_ui.invoice_actions(invoice, is_en) }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center">{{ is_en ? 'The list is empty' : 'Список пуст' }}</td>
                        </tr>
                    {% endfor %}
                {% elseif active_tab == 'all' %}
                    {% for invoice in visible_all_invoices %}
                        {% set invoice_status_class = invoice.status == 'paid' ? 'text-bg-success' : (invoice.status == 'unpaid' ? 'text-bg-warning' : (invoice.status == 'canceled' ? 'text-bg-secondary' : 'text-bg-danger')) %}
                        <tr>
                            <td><a href="{{ 'invoice'|link }}/{{ invoice.hash }}">{{ is_en ? 'Payment' : 'Платеж' }} #{{ invoice.serie ~ "%05s"|format(invoice.nr) }}</a></td>
                            <td>{{ invoice.created_at|format_date }}</td>
                            <td><span class="badge {{ invoice_status_class }}">{{ invoice.status|trans }}</span></td>
                            <td>{{ invoice.total | money(invoice.currency) }}</td>
                            <td>{{ invoice_ui.invoice_actions(invoice, is_en) }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center">{{ is_en ? 'The list is empty' : 'Список пуст' }}</td>
                        </tr>
                    {% endfor %}
                {% else %}
                    {% for invoice in unpaid_invoices.list %}
                        <tr>
                            <td><a href="{{ 'invoice'|link }}/{{ invoice.hash }}">{{ is_en ? 'Payment' : 'Платеж' }} #{{ invoice.serie ~ "%05s"|format(invoice.nr) }}</a></td>
                            <td>{{ invoice.created_at|format_date }}</td>
                            <td>{{ invoice.due_at|format_date }}</td>
                            <td>{{ invoice.total | money(invoice.currency) }}</td>
                            <td>{{ invoice_ui.invoice_actions(invoice, is_en) }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center">{{ is_en ? 'The list is empty' : 'Список пуст' }}</td>
                        </tr>
                    {% endfor %}
                {% endif %}
                </tbody>
            </table>
        </div>

        {{ include('partial_pagination.html.twig', { 'list': active_tab == 'paid' ? paid_invoices : (active_tab == 'unpaid' ? unpaid_invoices : all_invoices) }) }}
    </section>
{% endblock %}
