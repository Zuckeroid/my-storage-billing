{% extends "layout_default.html.twig" %}
{% set current_locale = guest.system_locale|default(settings.locale|default('ru_RU')) %}
{% set is_en = current_locale starts with 'en' %}
{% set telegram_url = 'https://t.me/znet_supp_bot' %}
{% set telegram_label = '@znet_supp_bot' %}

{% block meta_title %}{{ is_en ? 'Support' : 'Поддержка' }}{% endblock %}
{% block meta_description %}{{ is_en ? 'Reach Znet support through Telegram or send a message from the site.' : 'Свяжитесь с поддержкой Znet через Telegram или отправьте сообщение прямо с сайта.' }}{% endblock %}
{% block shell_title %}{{ is_en ? 'Support' : 'Поддержка' }}{% endblock %}
{% block shell_description %}{{ is_en ? 'Choose the fastest way to reach us or leave a message inside the same workspace.' : 'Выберите быстрый способ связи или отправьте сообщение прямо из этого пространства.' }}{% endblock %}
{% block body_class %}page-contacts{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">{{ is_en ? 'Support' : 'Поддержка' }}</li>
{% endblock %}

{% block content %}
    <section class="znet-shell-section">
        <div class="card">
            <div class="card-body d-flex align-items-center justify-content-between gap-3 flex-wrap">
                <h2 class="h5 mb-0">{{ is_en ? 'Telegram' : 'Telegram' }}</h2>
                <a class="znet-btn znet-btn-accent" href="{{ telegram_url }}" target="_blank" rel="noopener noreferrer">
                    {{ telegram_label }}
                </a>
            </div>
        </div>
    </section>
{% endblock %}
