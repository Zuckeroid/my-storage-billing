{% extends "layout_default.html.twig" %}

{% set current_locale = guest.system_locale|default(settings.locale|default('ru_RU')) %}
{% set is_en = current_locale starts with 'en' %}

{% block meta_title %}{{ is_en ? 'Login' : 'Вход' }}{% endblock %}
{% block meta_description %}{{ is_en ? 'Sign in to manage your connection, payments, and profile.' : 'Войдите, чтобы управлять подключением, оплатой и профилем.' }}{% endblock %}

{% block body_class %}page-login{% endblock %}
{% block shell_eyebrow %}{{ is_en ? 'Access' : 'Доступ' }}{% endblock %}
{% block shell_title %}{{ is_en ? 'Login' : 'Войти' }}{% endblock %}
{% block shell_description %}{{ is_en ? 'Use the same account you created in Znet.' : 'Используйте тот же аккаунт, который вы создали в Znet.' }}{% endblock %}
{% block shell_head_actions %}
    {% if settings.show_signup_link %}
        <a class="znet-btn znet-btn-accent" href="{{ 'signup'|link }}">{{ is_en ? 'Create account' : 'Создать аккаунт' }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="znet-shell-auth-wrap">
        <div class="card znet-shell-auth-card">
            <div class="card-body">
                <form method="post" action="{{ 'api/guest/client/login'|link }}" class="auth znet-auth-form" {{ fb_api_form({redirect: redirect_uri|default('/')|link}) }}>
                    <div class="mb-3">
                        <label class="form-label" for="znet-page-login-email">{{ 'Email'|trans }}</label>
                        <input
                            class="form-control"
                            id="znet-page-login-email"
                            type="email"
                            placeholder="{{ 'Enter your email address'|trans }}"
                            name="email"
                            value="{{ request.email }}"
                            required="required"
                            autocomplete="email"
                            autofocus
                        >
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="znet-page-login-password">{{ 'Password'|trans }}</label>
                        <input
                            class="form-control"
                            id="znet-page-login-password"
                            type="password"
                            placeholder="{{ 'Enter your password'|trans }}"
                            name="password"
                            required="required"
                            autocomplete="current-password"
                        >
                    </div>

                    <button type="submit" class="znet-btn znet-btn-accent znet-auth-submit">
                        {{ is_en ? 'Login' : 'Войти' }}
                    </button>
                </form>

                <div class="znet-auth-foot">
                    {% if settings.show_password_reset_link %}
                        <a class="znet-auth-text-link" href="{{ 'password-reset'|link }}">{{ 'Forgot password?'|trans }}</a>
                    {% endif %}

                    {% if settings.show_signup_link %}
                        <a class="znet-auth-text-link" href="{{ 'signup'|link }}">{{ is_en ? 'Registration' : 'Регистрация' }}</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
