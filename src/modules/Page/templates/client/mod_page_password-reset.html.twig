{% extends "layout_default.html.twig" %}
{% set current_locale = guest.system_locale|default(settings.locale|default('ru_RU')) %}
{% set is_en = current_locale starts with 'en' %}

{% block meta_title %}{{ is_en ? 'Reset password' : 'Сброс пароля' }}{% endblock %}
{% block meta_description %}{{ is_en ? 'Reset access to your account by confirming your email address.' : 'Восстановите доступ к аккаунту через подтверждение email.' }}{% endblock %}
{% set company = guest.system_company %}

{% block body_class %}page-password-reset{% endblock %}
{% block shell_eyebrow %}{{ is_en ? 'Access' : 'Доступ' }}{% endblock %}
{% block shell_title %}{{ is_en ? 'Reset password' : 'Сброс пароля' }}{% endblock %}
{% block shell_description %}{{ is_en ? 'Reset access to your account by confirming your email address.' : 'Восстановите доступ к аккаунту через подтверждение email.' }}{% endblock %}
{% block shell_head_actions %}
    <a class="znet-btn znet-btn-outline" href="{{ 'login'|link }}">{{ is_en ? 'Back to login' : 'Назад ко входу' }}</a>
{% endblock %}
{% block content %}
    <div class="znet-shell-auth-wrap">
        <div class="card znet-shell-auth-card">
            <div class="card-body">
                <form method="post" action="{{ 'api/guest/client/reset_password'|link }}" {{ fb_api_form({message: 'A password reset confirmation email will be sent to you if we found an account with that email address.'|trans}) }}>
                    <div class="mb-3">
                        <label class="form-label" for="email">{{ 'Email'|trans }}</label>
                        <input class="form-control" id="email" type="text" placeholder="{{ 'Enter your email address'|trans }}" name="email" value="{{ request.email }}" required="required" autofocus>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mb-3">{{ is_en ? 'Reset password' : 'Сбросить пароль' }}</button>
                </form>
                <a class="btn btn-outline-primary w-100" href="{{ 'login'|link }}">{{ is_en ? 'Back to login' : 'Назад ко входу' }}</a>
            </div>
        </div>
    </div>
{% endblock %}
