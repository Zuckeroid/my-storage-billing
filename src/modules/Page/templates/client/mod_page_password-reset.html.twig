{% extends "layout_default.html.twig" %}

{% set current_locale = guest.system_locale|default(settings.locale|default('ru_RU')) %}
{% set is_en = current_locale starts with 'en' %}

{% block meta_title %}{{ is_en ? 'Reset password' : 'Сброс пароля' }}{% endblock %}
{% block meta_description %}{{ is_en ? 'Reset access to your account by confirming your email address.' : 'Восстановите доступ к аккаунту через подтверждение email.' }}{% endblock %}

{% block body_class %}page-password-reset{% endblock %}
{% block shell_eyebrow %}{{ is_en ? 'Access' : 'Доступ' }}{% endblock %}
{% block shell_title %}{{ is_en ? 'Reset password' : 'Сброс пароля' }}{% endblock %}
{% block shell_description %}{{ is_en ? 'Enter your email. If we find an account, we will send a password reset link.' : 'Введите email. Если аккаунт найден, мы отправим ссылку для смены пароля.' }}{% endblock %}
{% block shell_head_actions %}
    <a class="znet-btn znet-btn-outline" href="{{ 'login'|link }}">{{ is_en ? 'Back to login' : 'Назад ко входу' }}</a>
{% endblock %}

{% block content %}
    <div class="znet-shell-auth-wrap">
        <div class="card znet-shell-auth-card">
            <div class="card-body">
                <form method="post" action="{{ 'api/guest/client/reset_password'|link }}" class="auth znet-auth-form" {{ fb_api_form({message: 'A password reset confirmation email will be sent to you if we found an account with that email address.'|trans}) }}>
                    <div class="mb-3">
                        <label class="form-label" for="znet-page-reset-email">{{ 'Email'|trans }}</label>
                        <input
                            class="form-control"
                            id="znet-page-reset-email"
                            type="email"
                            placeholder="{{ 'Enter your email address'|trans }}"
                            name="email"
                            value="{{ request.email }}"
                            required="required"
                            autocomplete="email"
                            autofocus
                        >
                    </div>

                    <button type="submit" class="znet-btn znet-btn-accent znet-auth-submit">
                        {{ is_en ? 'Reset password' : 'Сбросить пароль' }}
                    </button>
                </form>

                <div class="znet-auth-foot">
                    <a class="znet-auth-text-link" href="{{ 'login'|link }}">{{ is_en ? 'Back to login' : 'Назад ко входу' }}</a>
                    {% if settings.show_signup_link %}
                        <a class="znet-auth-text-link" href="{{ 'signup'|link }}">{{ is_en ? 'Registration' : 'Регистрация' }}</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
