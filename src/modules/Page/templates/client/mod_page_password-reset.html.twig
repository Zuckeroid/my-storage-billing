{% extends "layout_default.html.twig" %}

{% block meta_title %}{{ 'Reset Password'|trans }}{% endblock %}
{% block meta_description %}{{ 'Reset access to your account by confirming your email address.'|trans }}{% endblock %}
{% set company = guest.system_company %}

{% block body_class %}page-password-reset{% endblock %}
{% block shell_eyebrow %}{{ 'Access'|trans }}{% endblock %}
{% block shell_title %}{{ 'Reset Password'|trans }}{% endblock %}
{% block shell_description %}{{ 'Reset access to your account by confirming your email address.'|trans }}{% endblock %}
{% block shell_head_actions %}
    <a class="znet-btn znet-btn-outline" href="{{ 'login'|link }}">{{ 'Back to login'|trans }}</a>
{% endblock %}
{% block content %}
    <div class="znet-shell-auth-wrap">
        <div class="card znet-shell-auth-card">
            <div class="card-body">
                <form method="post" action="{{ 'api/guest/client/reset_password'|link }}" {{ fb_api_form({message: 'A password reset confirmation email will be sent to you if we found an account with that email address.'|trans}) }}>
                    <div class="mb-3">
                        <label class="form-label" for="email">{{ 'Email'|trans }}</label>
                        <input class="form-control" id="email" type="text" placeholder="{{ 'Enter your email address'|trans }}" name="email" value="{{ request.email }}" required="required" autofocus>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mb-3">{{ 'Reset Password'|trans }}</button>
                </form>
                <a class="btn btn-outline-primary w-100" href="{{ 'login'|link }}">{{ 'Back to login'|trans }}</a>
            </div>
        </div>
    </div>
{% endblock %}
