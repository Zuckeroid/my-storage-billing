{% extends "layout_default.html.twig" %}

{% block meta_title %}Оплата{% endblock %}
{% block meta_description %}Информация об оплате тарифов Znet и порядке получения доступа после оплаты.{% endblock %}
{% block body_class %}page-payment{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">Оплата</li>
{% endblock %}

{% block content %}
    <section class="card mb-3">
        <div class="card-body">
            <h2 class="h5">Доступные тарифы</h2>
            {% include 'partial_storage_plans.html.twig' with { storage_plan_view: 'list', is_en: false } %}
        </div>
    </section>

    <section class="card">
        <div class="card-body">
            <h2 class="h5">Порядок оплаты</h2>
            <ol class="mb-0">
                <li>Зарегистрируйтесь на сайте.</li>
                <li>Выберите тариф в разделе "Тарифы".</li>
                <li>Проверьте счет и оплатите его доступным способом.</li>
                <li>Дождитесь письма с инструкциями на зарегистрированный email.</li>
            </ol>
        </div>
    </section>
{% endblock %}
