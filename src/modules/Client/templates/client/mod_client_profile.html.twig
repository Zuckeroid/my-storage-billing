{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set current_locale = guest.system_locale|default(settings.locale|default('ru_RU')) %}
{% set is_en = current_locale starts with 'en' %}

{% block meta_title %}{{ is_en ? 'Profile details' : 'Р”РµС‚Р°Р»Рё РїСЂРѕС„РёР»СЏ' }}{% endblock %}
{% block meta_description %}{% endblock %}
{% block shell_title %}{{ is_en ? 'Profile details' : 'Р”РµС‚Р°Р»Рё РїСЂРѕС„РёР»СЏ' }}{% endblock %}
{% block shell_description %}{% endblock %}
{% block page_header %}{{ is_en ? 'Profile' : 'РџСЂРѕС„РёР»СЊ' }}{% endblock %}
{% block shell_head_actions %}{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">{{ is_en ? 'Profile' : 'РџСЂРѕС„РёР»СЊ' }}</li>
{% endblock %}

{% block body_class %}client-profile{% endblock %}
{% set required = guest.client_required %}

{% block content %}
    {% if guest.client_is_email_validation_required and not profile.email_approved %}
        <div class="alert alert-block alert-danger">
            <div class="row">
                <span>{{ is_en ? 'You must verify your email address before you may access our services.' : 'РџРѕРґС‚РІРµСЂРґРёС‚Рµ Р°РґСЂРµСЃ СЌР»РµРєС‚СЂРѕРЅРЅРѕР№ РїРѕС‡С‚С‹, С‡С‚РѕР±С‹ РїРѕР»СЊР·РѕРІР°С‚СЊСЃСЏ СЃРµСЂРІРёСЃРѕРј.' }}</span>
            </div>
            <a class="btn btn-primary" href="{{ 'api/client/client/resend_email_verification'|link }}"
               {{ fb_api_link({message: is_en ? 'Verification email re-sent' : 'РџРёСЃСЊРјРѕ РїРѕРґС‚РІРµСЂР¶РґРµРЅРёСЏ РѕС‚РїСЂР°РІР»РµРЅРѕ РїРѕРІС‚РѕСЂРЅРѕ'}) }}>{{ is_en ? 'Resend verification email' : 'РћС‚РїСЂР°РІРёС‚СЊ РїРёСЃСЊРјРѕ РµС‰Рµ СЂР°Р·' }}</a>
        </div>
    {% endif %}

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <form method="post" action="client/profile/update" id="profile-update" {{ fb_api_form({message: is_en ? 'Profile updated' : 'РџСЂРѕС„РёР»СЊ РѕР±РЅРѕРІР»РµРЅ'}) }}>
                        <input type="hidden" name="last_name" value="{{ profile.last_name }}">
                        <input type="hidden" name="gender" value="{{ profile.gender }}">
                        <input type="hidden" name="birthday" value="{{ profile.birthday }}">

                        <div class="row">
                            <div class="mb-3 col-md-6">
                                <label class="form-label" for="first_name">{{ is_en ? 'Nickname' : 'РџСЃРµРІРґРѕРЅРёРј' }}</label>
                                <input type="text" class="form-control" name="first_name" id="first_name" value="{{ profile.first_name }}" required>
                            </div>
                            <div class="mb-3 col-md-6">
                                <label class="form-label" for="phone">{{ is_en ? 'Phone number' : 'РќРѕРјРµСЂ С‚РµР»РµС„РѕРЅР°' }}</label>
                                <input type="hidden" name="phone_cc" value="{{ profile.phone_cc }}">
                                <input type="text" class="form-control" name="phone" id="phone" value="{{ profile.phone }}" {% if "phone" in required %} required {% endif %}>
                            </div>
                        </div>

                        <div class="row">
                            <div class="mb-3 col-md-6">
                                <label class="form-label" for="email">{{ is_en ? 'Email address' : 'РђРґСЂРµСЃ СЌР»РµРєС‚СЂРѕРЅРЅРѕР№ РїРѕС‡С‚С‹' }}</label>
                                <input type="email" class="form-control" id="email" name="email" value="{{ profile.email }}" required>
                            </div>
                            <div class="mb-3 col-md-6">
                                <label class="form-label" for="country">{{ is_en ? 'Country' : 'РЎС‚СЂР°РЅР°' }}</label>
                                <select class="form-select" id="country" name="country" {% if "country" in required %} required {% endif %}>
                                    <option value="">{{ is_en ? '-- Select country --' : '-- Р’С‹Р±РµСЂРёС‚Рµ СЃС‚СЂР°РЅСѓ --' }}</option>
                                    {% for val, label in guest.system_countries %}
                                        <option value="{{ val }}" label="{{ label|e }}" {% if val == profile.country %}selected="selected"{% endif %}>{{ label|e }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <button class="btn btn-primary" type="submit">{{ is_en ? 'Update profile' : 'РЎРѕС…СЂР°РЅРёС‚СЊ РїСЂРѕС„РёР»СЊ' }}</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
