{% extends "layout_default.html.twig" %}

{% set current_locale = guest.system_locale|default(settings.locale|default('ru_RU')) %}
{% set is_en = current_locale starts with 'en' %}

{% block meta_title %}{{ is_en ? 'Set new password' : 'Новый пароль' }}{% endblock %}
{% block meta_description %}{{ is_en ? 'Create a new password for your Znet account.' : 'Создайте новый пароль для аккаунта Znet.' }}{% endblock %}

{% block body_class %}page-set-password{% endblock %}
{% block shell_eyebrow %}{% endblock %}
{% block shell_title %}{{ is_en ? 'Set new password' : 'Новый пароль' }}{% endblock %}
{% block shell_description %}{% endblock %}
{% block shell_description_fallback %}off{% endblock %}
{% block shell_head_actions %}
    <a class="znet-btn znet-btn-outline" href="{{ 'login'|link }}">{{ is_en ? 'Back to login' : 'Назад ко входу' }}</a>
{% endblock %}

{% block content %}
    <div class="znet-shell-auth-wrap">
        <div class="card znet-shell-auth-card">
            <div class="card-body">
                <form method="post" action="{{ 'api/guest/client/update_password'|link }}" class="auth znet-auth-form" {{ fb_api_form({redirect: '/login'|link}) }} autocomplete="off">
                    <input type="hidden" id="znet-reset-hash" name="hash" value="{{ hash }}">

                    <div class="mb-3">
                        <label class="form-label" for="znet-page-new-password">{{ 'New password'|trans }}</label>
                        <input
                            class="form-control"
                            id="znet-page-new-password"
                            type="password"
                            placeholder="{{ 'New password'|trans }}"
                            name="password"
                            required="required"
                            autocomplete="new-password"
                            autofocus
                        >
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="znet-page-new-password-confirm">{{ 'Repeat new password'|trans }}</label>
                        <input
                            class="form-control"
                            id="znet-page-new-password-confirm"
                            type="password"
                            placeholder="{{ 'Repeat new password'|trans }}"
                            name="password_confirm"
                            required="required"
                            autocomplete="new-password"
                        >
                    </div>

                    <button type="submit" class="znet-btn znet-btn-accent znet-auth-submit">
                        {{ is_en ? 'Save new password' : 'Сохранить новый пароль' }}
                    </button>
                </form>

                <div class="znet-auth-foot">
                    <a class="znet-auth-text-link" href="{{ 'login'|link }}">{{ is_en ? 'Back to login' : 'Назад ко входу' }}</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block js %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const field = document.getElementById('znet-reset-hash');
        if (field && !field.value) {
            field.value = window.location.href.split('/').pop();
        }
    });
</script>
{% endblock %}
