{% extends request.ajax ? "layout_blank.html.twig" : (client ? "layout_default.html.twig" : "layout_public.html.twig") %}

{% import "macro_functions.html.twig" as mf %}

{% set current_locale = guest.system_locale|default(settings.locale|default('ru_RU')) %}
{% set is_en = current_locale starts with 'en' %}
{% set company = guest.system_company %}
{% if not client %}
    {% set storage_products = guest.product_get_list({ 'per_page': 100, 'show_hidden': false, 'type': 'custom' }).list|default([]) %}
{% endif %}

{% block meta_title %}
    {% if client %}
        {{ is_en ? 'Client area' : 'Личный кабинет' }}
    {% else %}
        {{ is_en ? 'Znet — secure access without extra noise' : 'Znet — безопасность, приватность, свобода' }}
    {% endif %}
{% endblock %}

{% block meta_description %}{% if not client %}{{ is_en ? 'Secure VPN access, clear plans, and fast setup in one account.' : 'Защищенный VPN-доступ, понятные тарифы и быстрый старт в одном аккаунте.' }}{% endif %}{% endblock %}

{% block head %}
    {% if not client %}
        <link rel="stylesheet" href="{{ 'css/znet-home.css' | asset_url }}?v=znet-home-20260512c">
    {% endif %}
{% endblock %}

{% block page_header %}{{ is_en ? 'VPN access' : 'VPN-доступ' }}{% endblock %}
{% block body_class %}{% if client %}dashboard storage-dashboard{% else %}public-homepage znet-homepage{% endif %}{% endblock %}
{% block shell_eyebrow %}{% if not client %}{{ parent() }}{% endif %}{% endblock %}
{% block shell_title %}{% if client %}{{ is_en ? 'Your Znet' : 'Ваш Znet' }}{% endif %}{% endblock %}
{% block shell_description %}{% endblock %}
{% block shell_head_actions %}{% endblock %}

{% block breadcrumbs %}
    {% if client and not settings.hide_dashboard_breadcrumb %}
        <ul class="breadcrumb">
            <li><a href="{{ '/'|link }}">{{ is_en ? 'Home' : 'Главная' }}</a> <span class="dropdown-divider">/</span></li>
            <li class="active">{{ is_en ? 'VPN access' : 'VPN-доступ' }}</li>
        </ul>
    {% endif %}
{% endblock %}

{% block content %}
    {% if client %}
        {% set dashboard = client.index_get_dashboard %}
        {% set profile = dashboard.profile %}
        {% set recent_orders = dashboard.recent_orders|default([]) %}
        {% set active_orders = recent_orders|filter(order => order.status == 'active') %}
        {% set primary_order = active_orders|first ?: recent_orders|first %}

        <section class="znet-shell-section">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                        <div>
                            <h2 class="h4 mb-2">{{ is_en ? 'Connection' : 'Подключение' }}</h2>
                            {% if dashboard.orders.active > 0 %}
                                <p class="text-secondary mb-0">
                                    {{ is_en
                                        ? 'Your VPN access is ready. Open the service page to install the app, get a token, or copy the subscription link.'
                                        : 'VPN-доступ готов. Откройте страницу услуги, чтобы установить приложение, получить токен или скопировать ссылку подписки.' }}
                                </p>
                            {% else %}
                                <p class="text-secondary mb-0">
                                    {{ is_en
                                        ? 'Choose a plan and pay the invoice. Access will appear here after activation.'
                                        : 'Выберите тариф и оплатите счет. Доступ появится здесь после активации.' }}
                                </p>
                            {% endif %}
                        </div>

                        {% if dashboard.orders.active > 0 and primary_order %}
                            <a class="btn btn-primary" href="{{ 'order/service/manage'|link }}/{{ primary_order.id }}">
                                {{ is_en ? 'Open connection' : 'Открыть подключение' }}
                            </a>
                        {% elseif dashboard.orders.active > 0 %}
                            <a class="btn btn-primary" href="{{ 'order/service'|link }}">
                                {{ is_en ? 'Open services' : 'Открыть услуги' }}
                            </a>
                        {% else %}
                            <a class="btn btn-primary" href="{{ '/order'|link }}">
                                {{ is_en ? 'Choose plan' : 'Выбрать тариф' }}
                            </a>
                        {% endif %}
                    </div>

                    <div class="znet-shell-stat-grid mt-4">
                        <article class="znet-shell-stat">
                            <div class="znet-shell-stat-line">
                                <span>{{ is_en ? 'Active services' : 'Активные услуги' }}</span>
                                <strong>{{ dashboard.orders.active }}</strong>
                            </div>
                            <a class="btn btn-sm btn-outline-primary znet-shell-stat-action" href="{{ 'order/service'|link }}">
                                {{ is_en ? 'Open' : 'Открыть' }}
                            </a>
                        </article>
                        <article class="znet-shell-stat">
                            <div class="znet-shell-stat-line">
                                <span>{{ is_en ? 'Unpaid invoices' : 'Неоплаченные счета' }}</span>
                                <strong>{{ dashboard.invoices.unpaid }}</strong>
                            </div>
                            <a class="btn btn-sm btn-outline-primary znet-shell-stat-action" href="{{ 'invoice'|link({ tab: 'unpaid' }) }}">
                                {{ is_en ? 'Pay' : 'Оплатить' }}
                            </a>
                        </article>
                        <article class="znet-shell-stat">
                            <div class="znet-shell-stat-line">
                                <span>{{ is_en ? 'Balance' : 'Баланс' }}</span>
                                <strong>{{ profile.balance | money(profile.currency) }}</strong>
                            </div>
                            <a class="btn btn-sm btn-outline-primary znet-shell-stat-action" href="{{ 'client/balance'|link }}#wallet-topup">
                                {{ is_en ? 'Top up' : 'Пополнить' }}
                            </a>
                        </article>
                    </div>
                </div>
            </div>
        </section>

        <section class="znet-shell-section">
            <div class="znet-shell-card-grid znet-shell-card-grid-2">
                <article class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h2 class="h5 mb-1">{{ is_en ? 'Payment' : 'Оплата' }}</h2>
                                <p class="text-secondary mb-0">
                                    {{ is_en
                                        ? 'Invoices and balance are here.'
                                        : 'Счета и баланс находятся здесь.' }}
                                </p>
                            </div>
                        </div>
                        <p class="mb-2">{{ is_en ? 'Unpaid invoices:' : 'Неоплаченные счета:' }} <strong>{{ dashboard.invoices.unpaid }}</strong></p>
                        <p class="mb-0 text-secondary">{{ is_en ? 'Balance:' : 'Баланс:' }} <strong>{{ profile.balance | money(profile.currency) }}</strong></p>
                        <div class="znet-shell-link-row mt-3">
                            <a class="btn btn-sm btn-outline-primary" href="{{ 'invoice'|link }}">{{ is_en ? 'Invoices' : 'Счета' }}</a>
                            <a class="btn btn-sm btn-outline-primary" href="{{ 'client/balance'|link }}">{{ is_en ? 'Balance' : 'Баланс' }}</a>
                        </div>
                    </div>
                </article>

                <article class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h2 class="h5 mb-1">{{ is_en ? 'Help' : 'Помощь' }}</h2>
                                <p class="text-secondary mb-0">
                                    {{ is_en
                                        ? 'Write to us if payment, connection, or the app needs attention.'
                                        : 'Напишите нам, если нужно помочь с оплатой, подключением или приложением.' }}
                                </p>
                            </div>
                            <a class="btn btn-sm btn-outline-primary" href="{{ '/contacts'|link }}">{{ is_en ? 'Contact' : 'Написать' }}</a>
                        </div>
                        <p class="mb-0 text-secondary">{{ profile.email }}</p>
                    </div>
                </article>
            </div>
        </section>
    {% endif %}
{% endblock %}

{% block body %}
    {% if client %}
        {{ parent() }}
    {% else %}
        {% include 'znet_homepage.html.twig' %}
    {% endif %}
{% endblock %}

{% block js %}{{ parent() }}{% endblock %}
