<!DOCTYPE html>
<html lang="{{ settings.locale|default('ru_RU')|split('_')[0] }}" data-bs-theme="{{ settings.theme|default('light') }}">
<head>
    <meta charset="utf-8">
    <title>{{ settings.meta_title_prefix }} {% block meta_title %}{% endblock %} {{ settings.meta_title_suffix }}</title>

    <meta name="description" content="{% block meta_description %}{{ settings.meta_description }}{% endblock %}">
    <meta name="keywords" content="{{ settings.meta_keywords }}">
    <meta name="robots" content="{{ settings.meta_robots }}">
    <meta name="author" content="{{ settings.meta_author }}">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% block opengraph %}{% endblock %}
    <link rel="stylesheet" href="{{ 'build/css/vendor.css' | asset_url }}?v=my-storage-20260418c">
    <link rel="stylesheet" href="{{ 'build/css/huraga.css' | asset_url }}?v=my-storage-20260418c">
    <link rel="shortcut icon" href="{{ guest.system_company.favicon_url }}">

    {{ "Api/API.js" | library_url | script_tag }}
    <script src="{{ 'build/js/huraga.js' | asset_url }}"></script>

    {{ DebugBar_renderHead() }}

    {% block head %}{% endblock %}
    {% block js %}{% endblock %}
</head>

<body class="{% block body_class %}{% endblock %}">

{% block body %}
{% if not client and settings.require_login %}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const publicPaths = [
                '/',
                '/about-us',
                '/contacts',
                '/payment',
                '/refund-policy',
                '/offer',
                '/tos',
                '/privacy-policy',
                '/signup',
                '/login'
            ];
            const currentPath = window.location.pathname;

            const isAllowed = publicPaths.some(path => currentPath === path || currentPath.startsWith(path + '/'));
            if (!isAllowed) {
                window.location.href = '{{ "login"|link }}';
            }
        });
    </script>
{% endif %}

{% if client and profile is not defined %}
    {% set profile = client.profile_get %}
{% endif %}
{% set company = guest.system_company %}
{% set languages = guest.extension_languages(true) %}
{% set current_locale = guest.system_locale|default(settings.locale|default('ru_RU')) %}
{% set is_en = current_locale starts with 'en' %}

<div class="storage-shell">
    <aside class="storage-sidebar" aria-label="My Storage navigation">
        <a class="storage-sidebar-brand" href="{{ '/'|link }}">
            <span class="brand-folder-icon" aria-hidden="true">
                <svg class="svg-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M3 6.75C3 5.78 3.78 5 4.75 5h5.4l2 2h7.1C20.22 7 21 7.78 21 8.75v8.5c0 .97-.78 1.75-1.75 1.75H4.75C3.78 19 3 18.22 3 17.25V6.75Z"/>
                </svg>
            </span>
            <span>{{ company.name }}</span>
        </a>

        <nav class="storage-tree" aria-label="Site sections">
            <details class="storage-tree-folder storage-tree-root-folder" open>
                <summary>
                    <span class="storage-folder-icon" aria-hidden="true"></span>
                    <span>{{ is_en ? 'Information' : 'Информация' }}</span>
                </summary>

                <a class="storage-tree-item" href="{{ '/'|link }}">
                    <span class="storage-file-icon" aria-hidden="true"></span>
                    <span>{{ is_en ? 'Home' : 'Главная' }}</span>
                </a>
                <a class="storage-tree-item" href="{{ '/payment'|link }}">
                    <span class="storage-file-icon" aria-hidden="true"></span>
                    <span>{{ is_en ? 'Payment' : 'Оплата' }}</span>
                </a>
                <a class="storage-tree-item" href="{{ '/about-us'|link }}">
                    <span class="storage-file-icon" aria-hidden="true"></span>
                    <span>{{ is_en ? 'About' : 'О сервисе' }}</span>
                </a>
                <a class="storage-tree-item" href="{{ '/contacts'|link }}">
                    <span class="storage-file-icon" aria-hidden="true"></span>
                    <span>{{ is_en ? 'Contacts' : 'Контакты' }}</span>
                </a>
            </details>

            <details class="storage-tree-folder storage-tree-root-folder" open>
                <summary>
                    <span class="storage-folder-icon" aria-hidden="true"></span>
                    <span>{{ is_en ? 'Documents' : 'Документы' }}</span>
                </summary>
                <a class="storage-tree-item" href="{{ '/offer'|link }}">
                    <span class="storage-file-icon" aria-hidden="true"></span>
                    <span>{{ is_en ? 'Offer' : 'Оферта' }}</span>
                </a>
                <a class="storage-tree-item" href="{{ '/tos'|link }}">
                    <span class="storage-file-icon" aria-hidden="true"></span>
                    <span>{{ is_en ? 'Agreement' : 'Соглашение' }}</span>
                </a>
                <a class="storage-tree-item" href="{{ '/privacy-policy'|link }}">
                    <span class="storage-file-icon" aria-hidden="true"></span>
                    <span>{{ is_en ? 'Privacy' : 'Конфиденциальность' }}</span>
                </a>
                <a class="storage-tree-item" href="{{ '/refund-policy'|link }}">
                    <span class="storage-file-icon" aria-hidden="true"></span>
                    <span>{{ is_en ? 'Refunds' : 'Возврат' }}</span>
                </a>
            </details>

            {% if client %}
                <details class="storage-tree-folder storage-tree-root-folder" open>
                    <summary>
                        <span class="storage-folder-icon" aria-hidden="true"></span>
                        <span>{{ is_en ? 'Account' : 'Аккаунт' }}</span>
                    </summary>
                    <a class="storage-tree-item" href="{{ '/'|link }}">
                        <span class="storage-file-icon" aria-hidden="true"></span>
                        <span>{{ is_en ? 'Dashboard' : 'Панель' }}</span>
                    </a>
                    <a class="storage-tree-item" href="{{ '/order/service'|link }}">
                        <span class="storage-file-icon" aria-hidden="true"></span>
                        <span>{{ is_en ? 'Services' : 'Услуги' }}</span>
                    </a>
                    <a class="storage-tree-item" href="{{ '/invoice'|link }}">
                        <span class="storage-file-icon" aria-hidden="true"></span>
                        <span>{{ is_en ? 'Invoices' : 'Счета' }}</span>
                    </a>
                    <a class="storage-tree-item" href="{{ 'client/profile'|link }}">
                        <span class="storage-file-icon" aria-hidden="true"></span>
                        <span>{{ is_en ? 'Profile' : 'Профиль' }}</span>
                    </a>
                </details>
            {% endif %}
        </nav>

        <div class="storage-sidebar-footer">
            {% if client %}
                <div class="storage-account-chip">
                    <div class="db-avatar rounded-circle" data-avatar-seed="{{ profile.email|hash('xxh128') }}" data-avatar-size="28" style="width: 28px; height: 28px;"></div>
                    <span>{{ profile.first_name }} {{ profile.last_name }}</span>
                </div>
            {% endif %}
        </div>
    </aside>

    <main class="storage-viewer">
        <div class="storage-viewer-toolbar">
            <div class="storage-path">
                <span class="storage-folder-icon" aria-hidden="true"></span>
                <span data-storage-path-root>{{ is_en ? 'Information' : 'Информация' }}</span>
                <span>/</span>
                <strong data-storage-path-page>{% block page_header %}Обзор{% endblock %}</strong>
            </div>
            <div class="storage-toolbar-actions">
                {% if client %}
                    <span class="storage-toolbar-user">{{ profile.first_name }} {{ profile.last_name }}</span>
                    <a class="btn btn-outline-primary btn-sm" href="{{ 'client/logout'|link }}">{{ is_en ? 'Logout' : 'Выйти' }}</a>
                {% else %}
                    <a class="btn btn-outline-primary btn-sm" href="{{ 'login'|link }}">{{ is_en ? 'Login' : 'Войти' }}</a>
                    <a class="btn btn-primary btn-sm" href="{{ 'signup'|link }}">{{ is_en ? 'Sign up' : 'Регистрация' }}</a>
                {% endif %}
                {% if languages|length > 1 %}
                    <select name="lang" class="form-select form-select-sm storage-language-selector js-language-selector" aria-label="{{ is_en ? 'Language' : 'Выбор языка' }}">
                        {% for lang in languages %}
                            <option value="{{ lang.locale }}" {% if lang.locale == current_locale %}selected{% endif %} data-custom-properties="&lt;span class=&quot;fi fi-{{ lang.locale|split('_')[1]|lower }}&quot;&gt;&lt;/span&gt;">&nbsp;{{ lang.title }}</option>
                        {% endfor %}
                    </select>
                {% endif %}
            </div>
        </div>

        <section class="storage-content-pane" role="main">
            {% block content_before %}{% endblock %}
            <div class="content-block" role="main">
                {% if settings.show_breadcrumb %}
                    {% block breadcrumbs %}
                        <nav aria-label="{{ 'breadcrumb'|trans }}">
                            <ol class="breadcrumb d-none d-md-flex">
                                <li class="breadcrumb-item"><a href="{{ '/'|link }}">{{ is_en ? 'Home' : 'Главная' }}</a></li>
                                {% block breadcrumb %}
                                    <li class="active breadcrumb-item">{{ is_en ? 'Overview' : 'Обзор' }}</li>
                                {% endblock %}
                            </ol>
                        </nav>
                    {% endblock %}
                {% endif %}

                {{ render_widgets('client.theme.content.before') }}
                {% block content %}{% endblock %}
                {{ render_widgets('client.theme.content.after') }}

                {{ include('partial_message.html.twig') }}

                {% block content_after %}{% endblock %}
            </div>
        </section>

        {% if settings.footer_enabled %}
            <footer id="footer" class="storage-footer small text-muted">
                <span>&copy; {{ now|format_date(pattern='yyyy') }} {{ settings.footer_signature | default(company.name) }}</span>
                <nav aria-label="Legal links">
                    <a href="{{ '/offer'|link }}">{{ is_en ? 'Offer' : 'Оферта' }}</a>
                    <a href="{{ '/tos'|link }}">{{ is_en ? 'Agreement' : 'Соглашение' }}</a>
                    <a href="{{ '/privacy-policy'|link }}">{{ is_en ? 'Privacy' : 'Конфиденциальность' }}</a>
                    <a href="{{ '/contacts'|link }}">{{ is_en ? 'Legal details' : 'Реквизиты' }}</a>
                </nav>
            </footer>
        {% endif %}
    </main>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1070;"></div>
    <div class="wait" style="display:none" onclick="this.style.display='none'">
        <div class="spinner-border"
             style="width: 4rem; height: 4rem; top: 50%; left: 50%; position: fixed; z-index: 999"></div>
    </div>
    <noscript>Для работы аккаунта My Storage включите JavaScript и cookies в настройках браузера.</noscript>
</div>

{% endblock %}

{% if settings.inject_javascript %}
    {{ settings.inject_javascript | raw }}
{% endif %}
{{ include('partial_pending_messages.html.twig', ignore_missing: true) }}
{% if guest.extension_is_on({ "mod": "cookieconsent" }) %}
    {{ include('mod_cookieconsent_index.html.twig', ignore_missing: true) }}
{% endif %}
{{ DebugBar_render() }}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const normalizePath = function (value) {
            try {
                const url = new URL(value, window.location.origin);
                return url.pathname.replace(/\/+$/, '') || '/';
            } catch (error) {
                return '/';
            }
        };
        const currentPath = normalizePath(window.location.href);

        document.querySelectorAll('.storage-tree-item[href]').forEach(function (item) {
            const itemPath = normalizePath(item.href);
            const isActive = itemPath === currentPath || (itemPath !== '/' && currentPath.startsWith(itemPath + '/'));

            item.classList.toggle('is-active', isActive);
            if (isActive) {
                item.setAttribute('aria-current', 'page');
                const parentFolder = item.closest('details');
                if (parentFolder) {
                    parentFolder.setAttribute('open', '');
                }
            } else {
                item.removeAttribute('aria-current');
            }
        });

        const activeItems = Array.from(document.querySelectorAll('.storage-tree-item.is-active'));
        const activeItem = activeItems.length > 0 ? activeItems[activeItems.length - 1] : null;
        const pathRoot = document.querySelector('[data-storage-path-root]');
        const pathPage = document.querySelector('[data-storage-path-page]');

        activeItems.forEach(function (item) {
            if (item !== activeItem) {
                item.classList.remove('is-active');
                item.removeAttribute('aria-current');
            }
        });

        if (activeItem && pathRoot && pathPage) {
            const activeFolder = activeItem.closest('details');
            const folderLabel = activeFolder ? activeFolder.querySelector('summary span:last-child') : null;
            const itemLabel = activeItem.querySelector('span:last-child');

            if (folderLabel) {
                pathRoot.textContent = folderLabel.textContent.trim();
            }
            if (itemLabel) {
                pathPage.textContent = itemLabel.textContent.trim();
            }
        }
    });
</script>
</body>
</html>
