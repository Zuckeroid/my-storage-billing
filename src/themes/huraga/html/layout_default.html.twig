<!DOCTYPE html>
<html lang="{{ settings.locale|default('ru_RU')|split('_')[0] }}" data-bs-theme="{{ settings.theme|default('light') }}">
<head>
    <meta charset="utf-8">
    <title>{{ settings.meta_title_prefix }} {% block meta_title %}{% endblock %} {{ settings.meta_title_suffix }}</title>

    <meta name="description" content="{% block meta_description %}{{ settings.meta_description }}{% endblock %}">
    <meta name="keywords" content="{{ settings.meta_keywords }}">
    <meta name="robots" content="{% block meta_robots %}{{ settings.meta_robots }}{% endblock %}">
    <meta name="author" content="{{ settings.meta_author }}">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% block opengraph %}{% endblock %}
    <link rel="stylesheet" href="{{ 'build/css/vendor.css' | asset_url }}?v=my-storage-20260418d">
    <link rel="stylesheet" href="{{ 'build/css/huraga.css' | asset_url }}?v=my-storage-20260418d">
    <link rel="stylesheet" href="{{ 'css/znet-shell.css' | asset_url }}?v=znet-shell-20260511a">
    <link rel="shortcut icon" href="{{ guest.system_company.favicon_url }}">

    {{ "Api/API.js" | library_url | script_tag }}
    <script src="{{ 'build/js/huraga.js' | asset_url }}?v=my-storage-20260418d"></script>

    {{ DebugBar_renderHead() }}

    {% block head %}{% endblock %}
    {% block js %}{% endblock %}
</head>

{% if client and profile is not defined %}
    {% set profile = client.profile_get %}
{% endif %}
{% set company = guest.system_company %}
{% set languages = guest.extension_languages(true) %}
{% set current_locale = guest.system_locale|default(settings.locale|default('ru_RU')) %}
{% set is_en = current_locale starts with 'en' %}
{% set next_locale = is_en ? 'ru_RU' : 'en_US' %}
{% set next_locale_flag = is_en ? 'ru' : 'us' %}
{% set next_locale_label = is_en ? 'RU' : 'US' %}
{% set shell_context = client ? 'client' : 'public' %}
{% set cart = client ? guest.cart_get : null %}
{% set cart_count = 0 %}
{% if cart and cart.items is defined %}
    {% set cart_count = cart.items|length %}
{% endif %}
{% block shell_eyebrow %}{{ client ? '' : (is_en ? 'Page' : 'Страница') }}{% endblock %}
{% block shell_title %}{% endblock %}
{% block shell_description %}{% endblock %}
{% set shell_eyebrow_text = block('shell_eyebrow')|striptags|trim %}
{% set shell_title_text = block('shell_title')|striptags|trim %}
{% if shell_title_text is empty %}
    {% set shell_title_text = block('meta_title')|striptags|trim %}
{% endif %}
{% set shell_description_text = block('shell_description')|striptags|trim %}
{% if shell_description_text is empty %}
    {% set shell_description_text = block('meta_description')|striptags|trim %}
{% endif %}

<body class="znet-shell-page znet-shell-{{ shell_context }} {% block body_class %}{% endblock %}">
{% block body %}
{% if not client and settings.require_login %}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const publicPaths = [
                '/',
                '/about-us',
                '/contacts',
                '/payment',
                '/refund-policy',
                '/offer',
                '/tos',
                '/privacy-policy',
                '/signup',
                '/login',
                '/password-reset'
            ];
            const currentPath = window.location.pathname;
            const isAllowed = publicPaths.some(path => currentPath === path || currentPath.startsWith(path + '/'));

            if (!isAllowed) {
                window.location.href = '{{ "login"|link }}';
            }
        });
    </script>
{% endif %}

<div class="znet-shell-page-shell">
    <header class="znet-shell-header znet-shell-header-desktop">
        <div class="znet-container znet-shell-header-bar">
            <a class="znet-shell-brand" href="{{ '/'|link }}" aria-label="Znet">
                <img class="znet-shell-brand-logo" src="{{ 'img/znet/Logo.png' | asset_url }}" alt="Znet">
            </a>

            {% if not client %}
                <nav class="znet-shell-nav" aria-label="{{ is_en ? 'Public navigation' : 'Публичная навигация' }}">
                    <a href="{{ '/payment'|link }}" data-znet-nav>{{ is_en ? 'Payment' : 'Оплата' }}</a>
                    <a href="{{ '/about-us'|link }}" data-znet-nav>{{ is_en ? 'About' : 'О сервисе' }}</a>
                    <a href="{{ '/contacts'|link }}" data-znet-nav>{{ is_en ? 'Support' : 'Поддержка' }}</a>
                    <a href="{{ '/offer'|link }}" data-znet-nav>{{ is_en ? 'Offer' : 'Оферта' }}</a>
                </nav>
            {% endif %}

            <div class="znet-shell-header-actions">
                {% if client %}
                    <a class="znet-btn znet-btn-ghost znet-btn-icon-only znet-shell-cart-link" href="{{ 'orderbutton'|link({ 'checkout': 1 }) }}" aria-label="{{ is_en ? 'Cart' : 'Корзина' }}">
                        <svg class="znet-btn-svg-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="9" cy="20" r="1.5"></circle>
                            <circle cx="18" cy="20" r="1.5"></circle>
                            <path d="M3 4h2.5l2.1 9.2a1 1 0 0 0 1 .8h8.7a1 1 0 0 0 1-.8L20 7H7.2"></path>
                        </svg>
                        {% if cart_count %}
                            <span class="znet-shell-cart-count">{{ cart_count > 9 ? '9+' : cart_count }}</span>
                        {% endif %}
                    </a>
                    <a class="znet-btn znet-btn-ghost znet-btn-with-icon" href="{{ 'client/profile'|link }}" aria-label="{{ is_en ? 'Profile' : 'Профиль' }}">
                        <svg class="znet-btn-svg-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="8" r="4"></circle>
                            <path d="M5 19c1.8-3 4.1-4.5 7-4.5s5.2 1.5 7 4.5"></path>
                        </svg>
                        <span>{{ is_en ? 'Profile' : 'Профиль' }}</span>
                    </a>
                    <a class="znet-btn znet-btn-accent" href="{{ 'client/logout'|link }}">{{ is_en ? 'Logout' : 'Выйти' }}</a>
                {% else %}
                    <a class="znet-btn znet-btn-ghost znet-btn-with-icon" href="{{ 'login'|link }}" aria-label="{{ is_en ? 'Login' : 'Войти' }}">
                        <svg class="znet-btn-svg-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="8" r="4"></circle>
                            <path d="M5 19c1.8-3 4.1-4.5 7-4.5s5.2 1.5 7 4.5"></path>
                        </svg>
                        <span>{{ is_en ? 'Login' : 'Войти' }}</span>
                    </a>
                    <a class="znet-btn znet-btn-accent" href="{{ 'signup'|link }}">{{ is_en ? 'Create account' : 'Создать аккаунт' }}</a>
                {% endif %}

                {% if languages|length > 1 %}
                    <div class="znet-shell-locale-switch" aria-label="{{ is_en ? 'Language' : 'Выбор языка' }}">
                        <button
                            class="znet-shell-locale-btn"
                            type="button"
                            data-znet-locale="{{ next_locale }}"
                            aria-label="{{ is_en ? 'Switch language to Russian' : 'Переключить язык на английский' }}"
                        >
                            <span class="fi fi-{{ next_locale_flag }}" aria-hidden="true"></span>
                            <span>{{ next_locale_label }}</span>
                        </button>
                    </div>
                {% endif %}
            </div>
        </div>
    </header>

    <header class="znet-shell-header znet-shell-header-mobile">
        <div class="znet-container znet-shell-header-bar">
            <a class="znet-shell-brand" href="{{ '/'|link }}" aria-label="Znet">
                <img class="znet-shell-brand-logo" src="{{ 'img/znet/Logo.png' | asset_url }}" alt="Znet">
            </a>

            <div class="znet-shell-header-actions">
                {% if client %}
                    <a class="znet-btn znet-btn-ghost znet-btn-icon-only znet-shell-cart-link" href="{{ 'orderbutton'|link({ 'checkout': 1 }) }}" aria-label="{{ is_en ? 'Cart' : 'Корзина' }}">
                        <svg class="znet-btn-svg-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="9" cy="20" r="1.5"></circle>
                            <circle cx="18" cy="20" r="1.5"></circle>
                            <path d="M3 4h2.5l2.1 9.2a1 1 0 0 0 1 .8h8.7a1 1 0 0 0 1-.8L20 7H7.2"></path>
                        </svg>
                        {% if cart_count %}
                            <span class="znet-shell-cart-count">{{ cart_count > 9 ? '9+' : cart_count }}</span>
                        {% endif %}
                    </a>
                    <a class="znet-btn znet-btn-ghost znet-btn-icon-only" href="{{ 'client/profile'|link }}" aria-label="{{ is_en ? 'Profile' : 'Профиль' }}">
                        <svg class="znet-btn-svg-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="8" r="4"></circle>
                            <path d="M5 19c1.8-3 4.1-4.5 7-4.5s5.2 1.5 7 4.5"></path>
                        </svg>
                    </a>
                {% else %}
                    <a class="znet-btn znet-btn-ghost znet-btn-icon-only" href="{{ 'login'|link }}" aria-label="{{ is_en ? 'Login' : 'Войти' }}">
                        <svg class="znet-btn-svg-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="8" r="4"></circle>
                            <path d="M5 19c1.8-3 4.1-4.5 7-4.5s5.2 1.5 7 4.5"></path>
                        </svg>
                    </a>
                {% endif %}

                <button
                    class="znet-btn znet-btn-ghost znet-btn-icon-only znet-shell-menu-toggle"
                    type="button"
                    aria-label="{{ is_en ? 'Menu' : 'Меню' }}"
                    aria-expanded="false"
                    aria-controls="znet-shell-mobile-menu"
                >
                    <svg class="znet-btn-svg-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 7h16"></path>
                        <path d="M4 12h16"></path>
                        <path d="M4 17h16"></path>
                    </svg>
                </button>
            </div>

            <nav class="znet-shell-menu" id="znet-shell-mobile-menu" aria-label="{{ is_en ? 'Mobile navigation' : 'Мобильная навигация' }}">
                {% if client %}
                    <a href="{{ 'client/logout'|link }}">{{ is_en ? 'Logout' : 'Выйти' }}</a>
                {% else %}
                    <a href="{{ '/payment'|link }}" data-znet-nav>{{ is_en ? 'Payment' : 'Оплата' }}</a>
                    <a href="{{ '/about-us'|link }}" data-znet-nav>{{ is_en ? 'About' : 'О сервисе' }}</a>
                    <a href="{{ '/contacts'|link }}" data-znet-nav>{{ is_en ? 'Support' : 'Поддержка' }}</a>
                    <a href="{{ '/offer'|link }}" data-znet-nav>{{ is_en ? 'Offer' : 'Оферта' }}</a>
                    <a href="{{ 'signup'|link }}">{{ is_en ? 'Create account' : 'Создать аккаунт' }}</a>
                {% endif %}

                {% if languages|length > 1 %}
                    <div class="znet-shell-menu-language">
                        <div class="znet-shell-locale-switch" aria-label="{{ is_en ? 'Language' : 'Выбор языка' }}">
                            <button
                                class="znet-shell-locale-btn"
                                type="button"
                                data-znet-locale="{{ next_locale }}"
                                aria-label="{{ is_en ? 'Switch language to Russian' : 'Переключить язык на английский' }}"
                            >
                                <span class="fi fi-{{ next_locale_flag }}" aria-hidden="true"></span>
                                <span>{{ next_locale_label }}</span>
                            </button>
                        </div>
                    </div>
                {% endif %}
            </nav>
        </div>
    </header>

    <main id="top" class="znet-shell-stage">
        <div class="znet-container znet-shell-stage-inner">
            <div class="znet-shell-globe" aria-hidden="true">
                <img src="{{ 'img/znet/Earth-15.png' | asset_url }}" alt="">
            </div>

            <div class="znet-shell-panel-shell">
                <section class="znet-shell-panel">
                    {% if shell_title_text %}
                        <div class="znet-shell-panel-head">
                            <div>
                                {% if shell_eyebrow_text %}
                                    <span class="znet-shell-eyebrow">{{ shell_eyebrow_text }}</span>
                                {% endif %}
                                <h1>{{ shell_title_text }}</h1>
                                {% if shell_description_text %}
                                    <p>{{ shell_description_text }}</p>
                                {% endif %}
                            </div>

                            <div class="znet-shell-head-actions">
                                {% block shell_head_actions %}{% endblock %}
                            </div>
                        </div>
                    {% endif %}

                    {% if client %}
                        <div class="znet-shell-mobile-links">
                            <a href="{{ '/'|link }}" data-znet-nav>{{ is_en ? 'Overview' : 'Обзор' }}</a>
                            <a href="{{ '/order/service'|link }}" data-znet-nav>{{ is_en ? 'Connection' : 'Подключение' }}</a>
                            <a href="{{ '/invoice'|link }}" data-znet-nav>{{ is_en ? 'Payment' : 'Оплата' }}</a>
                            <a href="{{ 'client/profile'|link }}" data-znet-nav>{{ is_en ? 'Profile' : 'Профиль' }}</a>
                        </div>
                    {% endif %}

                    <div class="znet-shell-layout {% if client %}znet-shell-layout-client{% else %}znet-shell-layout-public{% endif %}">
                        {% if client %}
                            <aside class="znet-shell-sidebar" aria-label="{{ is_en ? 'Client sections' : 'Разделы клиента' }}">
                                <div class="znet-shell-sidebar-block">
                                    <p class="znet-shell-side-label">{{ is_en ? 'Sections' : 'Разделы' }}</p>
                                    <nav class="znet-shell-side-nav">
                                        <a href="{{ '/'|link }}" data-znet-nav>{{ is_en ? 'Overview' : 'Обзор' }}</a>
                                        <a href="{{ '/order/service'|link }}" data-znet-nav>{{ is_en ? 'Connection' : 'Подключение' }}</a>
                                        <a href="{{ '/invoice'|link }}" data-znet-nav>{{ is_en ? 'Payment' : 'Оплата' }}</a>
                                        <a href="{{ '/client/profile'|link }}" data-znet-nav>{{ is_en ? 'Profile' : 'Профиль' }}</a>
                                    </nav>
                                </div>
                            </aside>
                        {% endif %}

                        <div class="znet-shell-main">
                            {% block content_before %}{% endblock %}
                            <div class="znet-shell-content" role="main">
                                {{ render_widgets('client.theme.content.before') }}
                                {% block content %}{% endblock %}
                                {{ render_widgets('client.theme.content.after') }}
                                {{ include('partial_message.html.twig') }}
                                {% block content_after %}{% endblock %}
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </main>

    {% if settings.footer_enabled %}
        <footer class="znet-shell-footer">
            <div class="znet-container znet-shell-footer-shell">
                <div class="znet-shell-footer-brand">
                    <img class="znet-shell-brand-logo znet-shell-footer-brand-logo" src="{{ 'img/znet/Logo.png' | asset_url }}" alt="Znet">
                </div>

                {% if not client %}
                    <nav class="znet-shell-footer-nav" aria-label="{{ is_en ? 'Footer navigation' : 'Навигация в подвале' }}">
                        <a href="{{ '/payment'|link }}" data-znet-nav>{{ is_en ? 'Payment' : 'Оплата' }}</a>
                        <a href="{{ '/offer'|link }}" data-znet-nav>{{ is_en ? 'Offer' : 'Оферта' }}</a>
                        <a href="{{ '/tos'|link }}" data-znet-nav>{{ is_en ? 'Agreement' : 'Соглашение' }}</a>
                        <a href="{{ '/privacy-policy'|link }}" data-znet-nav>{{ is_en ? 'Privacy' : 'Конфиденциальность' }}</a>
                        <a href="{{ '/refund-policy'|link }}" data-znet-nav>{{ is_en ? 'Refunds' : 'Возврат' }}</a>
                        <a href="{{ '/contacts'|link }}" data-znet-nav>{{ is_en ? 'Support' : 'Поддержка' }}</a>
                    </nav>
                {% endif %}
            </div>
        </footer>
    {% endif %}
</div>
{% endblock %}

{% if settings.inject_javascript %}
    {{ settings.inject_javascript | raw }}
{% endif %}
{{ include('partial_pending_messages.html.twig', ignore_missing: true) }}
{% if guest.extension_is_on({ "mod": "cookieconsent" }) %}
    {{ include('mod_cookieconsent_index.html.twig', ignore_missing: true) }}
{% endif %}
{{ DebugBar_render() }}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const setCookie = function (name, value, days) {
            let expires = '';

            if (days) {
                const date = new Date();
                date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);
                expires = '; expires=' + date.toUTCString();
            }

            document.cookie = name + '=' + encodeURIComponent(value) + expires + '; path=/';
        };

        const normalizePath = function (value) {
            try {
                const url = new URL(value, window.location.origin);
                return url.pathname.replace(/\/+$/, '') || '/';
            } catch (error) {
                return '/';
            }
        };

        const currentPath = normalizePath(window.location.href);

        document.querySelectorAll('[data-znet-nav]').forEach(function (item) {
            const itemPath = normalizePath(item.href);
            const isActive = itemPath === currentPath || (itemPath !== '/' && currentPath.startsWith(itemPath + '/'));
            item.classList.toggle('is-active', isActive);

            if (isActive) {
                item.setAttribute('aria-current', 'page');
            } else {
                item.removeAttribute('aria-current');
            }
        });

        document.querySelectorAll('[data-znet-locale]').forEach(function (button) {
            button.addEventListener('click', function () {
                const locale = button.getAttribute('data-znet-locale');

                if (!locale || locale === '{{ current_locale }}') {
                    return;
                }

                setCookie('fb_locale', locale, 365);
                window.location.reload();
            });
        });

        const mobileHeader = document.querySelector('.znet-shell-header-mobile');
        const toggle = mobileHeader?.querySelector('.znet-shell-menu-toggle');
        const menu = mobileHeader?.querySelector('#znet-shell-mobile-menu');

        if (mobileHeader && toggle && menu) {
            const closeMenu = function () {
                mobileHeader.classList.remove('is-menu-open');
                toggle.setAttribute('aria-expanded', 'false');
            };

            const openMenu = function () {
                mobileHeader.classList.add('is-menu-open');
                toggle.setAttribute('aria-expanded', 'true');
            };

            toggle.addEventListener('click', function () {
                if (mobileHeader.classList.contains('is-menu-open')) {
                    closeMenu();
                } else {
                    openMenu();
                }
            });

            menu.querySelectorAll('a').forEach(function (link) {
                link.addEventListener('click', closeMenu);
            });

            document.addEventListener('click', function (event) {
                if (!mobileHeader.contains(event.target)) {
                    closeMenu();
                }
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeMenu();
                }
            });
        }
    });
</script>
</body>
</html>
