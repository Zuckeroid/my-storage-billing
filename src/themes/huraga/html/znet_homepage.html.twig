{% set languages = guest.extension_languages(true) %}
{% set current_locale = guest.system_locale|default(settings.locale|default('ru_RU')) %}
{% set is_en = current_locale starts with 'en' %}
{% set next_locale = is_en ? 'ru_RU' : 'en_US' %}
{% set next_locale_flag = is_en ? 'ru' : 'us' %}
{% set next_locale_label = is_en ? 'RU' : 'US' %}

<div class="znet-page-shell">
    <header class="znet-site-header znet-site-header-desktop">
        <div class="znet-container znet-header-bar">
            <a class="znet-brand" href="#top" aria-label="Znet">
                <img class="znet-brand-logo" src="{{ 'img/znet/Logo.png'|asset_url }}" alt="Znet">
            </a>

            <nav class="znet-nav" aria-label="{{ is_en ? 'Main navigation' : 'Основная навигация' }}">
                <a href="#plans">{{ is_en ? 'Plans' : 'Тарифы' }}</a>
                <a href="{{ '/payment'|link }}">{{ is_en ? 'Payment' : 'Оплата' }}</a>
                <a href="{{ '/about-us'|link }}">{{ is_en ? 'About' : 'О сервисе' }}</a>
                <a href="{{ '/contacts'|link }}">{{ is_en ? 'Support' : 'Поддержка' }}</a>
            </nav>

            <div class="znet-header-actions">
                <a class="znet-btn znet-btn-ghost znet-btn-with-icon" href="{{ 'login'|link }}" aria-label="{{ is_en ? 'Login' : 'Войти' }}">
                    <svg class="znet-btn-svg-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="8" r="4"></circle>
                        <path d="M5 19c1.8-3 4.1-4.5 7-4.5s5.2 1.5 7 4.5"></path>
                    </svg>
                    <span>{{ is_en ? 'Login' : 'Войти' }}</span>
                </a>
                <a class="znet-btn znet-btn-accent" href="{{ 'signup'|link }}">{{ is_en ? 'Create account' : 'Создать аккаунт' }}</a>
                {% if languages|length > 1 %}
                    <div class="znet-locale-switch" aria-label="{{ is_en ? 'Language' : 'Выбор языка' }}">
                        <button
                            class="znet-locale-btn"
                            type="button"
                            data-znet-locale="{{ next_locale }}"
                            aria-label="{{ is_en ? 'Switch language to Russian' : 'Переключить язык на английский' }}"
                        >
                            <span class="fi fi-{{ next_locale_flag }}" aria-hidden="true"></span>
                            <span>{{ next_locale_label }}</span>
                        </button>
                    </div>
                {% endif %}
            </div>
        </div>
    </header>

    <header class="znet-site-header znet-site-header-mobile">
        <div class="znet-container znet-header-bar">
            <a class="znet-brand" href="#top" aria-label="Znet">
                <img class="znet-brand-logo" src="{{ 'img/znet/Logo.png'|asset_url }}" alt="Znet">
            </a>

            <div class="znet-header-actions">
                <a class="znet-btn znet-btn-ghost znet-btn-icon-only" href="{{ 'login'|link }}" aria-label="{{ is_en ? 'Login' : 'Войти' }}">
                    <svg class="znet-btn-svg-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="8" r="4"></circle>
                        <path d="M5 19c1.8-3 4.1-4.5 7-4.5s5.2 1.5 7 4.5"></path>
                    </svg>
                </a>
                <button
                    class="znet-btn znet-btn-ghost znet-btn-icon-only znet-header-menu-toggle"
                    type="button"
                    aria-label="{{ is_en ? 'Menu' : 'Меню' }}"
                    aria-expanded="false"
                    aria-controls="znet-mobile-header-nav"
                >
                    <svg class="znet-btn-svg-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 7h16"></path>
                        <path d="M4 12h16"></path>
                        <path d="M4 17h16"></path>
                    </svg>
                </button>
            </div>

            <nav class="znet-nav" id="znet-mobile-header-nav" aria-label="{{ is_en ? 'Mobile navigation' : 'Мобильная навигация' }}">
                <a href="#plans">{{ is_en ? 'Plans' : 'Тарифы' }}</a>
                <a href="{{ '/payment'|link }}">{{ is_en ? 'Payment' : 'Оплата' }}</a>
                <a href="{{ '/about-us'|link }}">{{ is_en ? 'About' : 'О сервисе' }}</a>
                <a href="{{ '/contacts'|link }}">{{ is_en ? 'Support' : 'Поддержка' }}</a>
                {% if languages|length > 1 %}
                    <div class="znet-menu-language">
                        <div class="znet-locale-switch" aria-label="{{ is_en ? 'Language' : 'Выбор языка' }}">
                            <button
                                class="znet-locale-btn"
                                type="button"
                                data-znet-locale="{{ next_locale }}"
                                aria-label="{{ is_en ? 'Switch language to Russian' : 'Переключить язык на английский' }}"
                            >
                                <span class="fi fi-{{ next_locale_flag }}" aria-hidden="true"></span>
                                <span>{{ next_locale_label }}</span>
                            </button>
                        </div>
                    </div>
                {% endif %}
            </nav>
        </div>
    </header>

    {% include 'znet_auth_panels.html.twig' %}

    <main id="top">
        <section class="znet-hero znet-hero-desktop">
            <div class="znet-container znet-hero-grid">
                <div class="znet-hero-content">
                    <div class="znet-hero-copy">
                        <h1>
                            {{ is_en ? 'Security.' : 'Безопасность.' }}<br>
                            {{ is_en ? 'Privacy.' : 'Приватность.' }}<br>
                            <span>{{ is_en ? 'Freedom.' : 'Свобода.' }}</span>
                        </h1>

                        <div class="znet-hero-points">
                            <div class="znet-hero-point">
                                <span class="znet-check">✓</span>
                                <span>{{ is_en ? 'Fast servers around the world.' : 'Быстрые серверы по всему миру.' }}</span>
                            </div>
                            <div class="znet-hero-point">
                                <span class="znet-check">✓</span>
                                <span>{{ is_en ? 'Simple connection setup.' : 'Простая настройка подключения.' }}</span>
                            </div>
                            <div class="znet-hero-point">
                                <span class="znet-check">✓</span>
                                <span>{{ is_en ? 'Adaptive connection stability.' : 'Адаптивное поддержание соединения.' }}</span>
                            </div>
                        </div>
                    </div>

                    <div class="znet-hero-actions">
                        <a class="znet-btn znet-btn-accent znet-btn-large znet-btn-with-icon znet-hero-primary-action" href="#plans">
                            <span>{{ is_en ? 'Choose a subscription' : 'Выбрать подписку' }}</span>
                            <svg class="znet-btn-svg-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M5 12h14"></path>
                                <path d="M13 7l5 5-5 5"></path>
                            </svg>
                        </a>
                        <a class="znet-btn znet-btn-outline znet-btn-large" href="{{ 'signup'|link }}">{{ is_en ? 'Try for free' : 'Попробовать бесплатно' }}</a>
                    </div>
                </div>

                <div class="znet-hero-visual" aria-label="{{ is_en ? 'Earth visual' : 'Изображение Земли' }}">
                    <img class="znet-hero-globe" src="{{ 'img/znet/Earth-15.png'|asset_url }}" alt="">
                </div>
            </div>
        </section>

        <section class="znet-hero znet-hero-mobile">
            <div class="znet-container znet-hero-grid">
                <div class="znet-hero-visual" aria-label="{{ is_en ? 'Earth visual' : 'Изображение Земли' }}">
                    <img class="znet-hero-globe" src="{{ 'img/znet/Earth-15.png'|asset_url }}" alt="">
                </div>

                <div class="znet-hero-content">
                    <div class="znet-hero-copy">
                        <h1>
                            {{ is_en ? 'Security.' : 'Безопасность.' }}<br>
                            {{ is_en ? 'Privacy.' : 'Приватность.' }}<br>
                            <span>{{ is_en ? 'Freedom.' : 'Свобода.' }}</span>
                        </h1>
                        <p>
                            {% if is_en %}
                                Protect your data and enjoy<br>
                                fast internet without borders.
                            {% else %}
                                Защищайте свои данные и наслаждайтесь<br>
                                быстрым интернетом без границ.
                            {% endif %}
                        </p>

                        <div class="znet-hero-points">
                            <div class="znet-hero-point">
                                <span class="znet-check">✓</span>
                                <span>{{ is_en ? 'Fast servers around the world.' : 'Быстрые серверы по всему миру.' }}</span>
                            </div>
                            <div class="znet-hero-point">
                                <span class="znet-check">✓</span>
                                <span>{{ is_en ? 'Simple connection setup.' : 'Простая настройка подключения.' }}</span>
                            </div>
                            <div class="znet-hero-point">
                                <span class="znet-check">✓</span>
                                <span>{{ is_en ? 'Adaptive connection stability.' : 'Адаптивное поддержание соединения.' }}</span>
                            </div>
                        </div>
                    </div>

                    <div class="znet-hero-actions">
                        <a class="znet-btn znet-btn-accent znet-btn-large znet-btn-with-icon znet-hero-primary-action" href="#plans">
                            <span>{{ is_en ? 'Choose a subscription' : 'Выбрать подписку' }}</span>
                            <svg class="znet-btn-svg-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M5 12h14"></path>
                                <path d="M13 7l5 5-5 5"></path>
                            </svg>
                        </a>
                        <a class="znet-btn znet-btn-outline znet-btn-large" href="{{ 'signup'|link }}">{{ is_en ? 'Try for free' : 'Попробовать бесплатно' }}</a>
                    </div>
                </div>
            </div>
        </section>

        <div class="znet-section-divider" aria-hidden="true">
            <div class="znet-container">
                <span class="znet-section-divider-line"></span>
            </div>
        </div>

        <section id="features" class="znet-feature-strip">
            <div class="znet-container znet-feature-grid">
                <article class="znet-feature-card">
                    <div class="znet-feature-title">
                        <img class="znet-feature-icon" src="{{ 'img/znet/Shield.png'|asset_url }}" alt="" aria-hidden="true">
                        <h2>{{ is_en ? 'Data protection' : 'Защита данных' }}</h2>
                    </div>
                    <p>{{ is_en ? 'Your data is protected by reliable encryption.' : 'Ваши данные под защитой надежного шифрования.' }}</p>
                </article>
                <article class="znet-feature-card">
                    <div class="znet-feature-title">
                        <img class="znet-feature-icon" src="{{ 'img/znet/Globe.png'|asset_url }}" alt="" aria-hidden="true">
                        <h2>{{ is_en ? 'Access without borders' : 'Доступ без границ' }}</h2>
                    </div>
                    <p>{{ is_en ? 'Access any content you need.' : 'Получайте доступ к любому контенту.' }}</p>
                </article>
                <article class="znet-feature-card">
                    <div class="znet-feature-title">
                        <img class="znet-feature-icon" src="{{ 'img/znet/Lightning.png'|asset_url }}" alt="" aria-hidden="true">
                        <h2>{{ is_en ? 'High speed' : 'Высокая скорость' }}</h2>
                    </div>
                    <p>{{ is_en ? 'Optimized servers provide a fast connection.' : 'Оптимизированные серверы обеспечивают быстрое соединение.' }}</p>
                </article>
                <article class="znet-feature-card">
                    <div class="znet-feature-title">
                        <img class="znet-feature-icon znet-feature-icon-phone" src="{{ 'img/znet/Phone.png'|asset_url }}" alt="" aria-hidden="true">
                        <h2>{{ is_en ? 'All-device support' : 'Поддержка всех устройств' }}</h2>
                    </div>
                    <p>{{ is_en ? 'Works on iOS, Android, Windows, macOS, and routers.' : 'Работает на: iOS, Android, Windows, macOS, роутерах.' }}</p>
                </article>
            </div>
        </section>

        <div class="znet-section-divider" aria-hidden="true">
            <div class="znet-container">
                <span class="znet-section-divider-line"></span>
            </div>
        </div>

        <section id="plans" class="znet-plans-section">
            <div class="znet-container">
                <div class="znet-section-head">
                    <span class="znet-eyebrow">{{ is_en ? 'Plans' : 'Тарифные планы' }}</span>
                    <h2>{{ is_en ? 'Choose your ideal plan' : 'Выберите свой идеальный план' }}</h2>
                    <p>{{ is_en ? 'Flexible plans for different goals and budgets.' : 'Гибкие тарифы для любых задач и бюджета.' }}</p>
                </div>

                <div class="znet-plans-grid">
                    {% for product in storage_products %}
                        {% set price = '' %}
                        {% set period = '' %}
                        {% set base_href = client ? ('invoice'|link ~ '#plans') : ('signup'|link) %}
                        {% if product.pricing.type == 'recurrent' and product.pricing.recurrent['1M'] is defined and product.pricing.recurrent['1M'].enabled %}
                            {% set price = product.pricing.recurrent['1M'].price|money_convert|replace({'.00': ''}) %}
                            {% set period = is_en ? 'per month' : 'в месяц' %}
                        {% elseif product.pricing.type == 'once' %}
                            {% set price = product.pricing.once.price|money_convert|replace({'.00': ''}) %}
                        {% elseif product.pricing.type == 'free' %}
                            {% set price = 0|money_convert %}
                        {% endif %}

                        {% set description = product.description ? product.description|striptags|trim : '' %}

                        <article class="znet-plan-card{% if loop.index == 2 %} znet-plan-card-featured{% endif %}">
                            {% if loop.index == 2 %}
                                <div class="znet-plan-badge">{{ is_en ? 'Popular' : 'Оптимальный' }}</div>
                            {% endif %}

                            <div class="znet-plan-top">
                                <div class="znet-plan-summary">
                                    <span class="znet-plan-name">{{ product.title }}</span>
                                    {% if price %}
                                        <strong class="znet-plan-price" data-plan-price>{{ price }}</strong>
                                    {% endif %}
                                    {% if product.pricing.type == 'recurrent' %}
                                        <label class="znet-plan-period-control">
                                            <span class="visually-hidden">{{ is_en ? 'Billing period' : 'Период оплаты' }}</span>
                                            <select class="znet-plan-period-select" data-plan-period>
                                                {% for code, prices in product.pricing.recurrent %}
                                                    {% if prices.enabled %}
                                                        <option
                                                            value="{{ code }}"
                                                            data-price="{{ prices.price|money_convert|replace({'.00': ''}) }}"
                                                            data-href="{{ base_href }}"
                                                            {% if code == '1M' %}selected="selected"{% endif %}
                                                        >
                                                            {% if code == '1M' %}
                                                                {{ is_en ? '1 month' : '1 месяц' }}
                                                            {% elseif code == '3M' %}
                                                                {{ is_en ? '3 months' : '3 месяца' }}
                                                            {% else %}
                                                                {{ guest.system_periods[code] }}
                                                            {% endif %}
                                                        </option>
                                                    {% endif %}
                                                {% endfor %}
                                            </select>
                                        </label>
                                    {% elseif period %}
                                        <span class="znet-plan-period">{{ period }}</span>
                                    {% endif %}
                                    <div class="znet-plan-highlight">
                                        <span class="znet-check">✓</span>
                                        <span>{{ description ?: (is_en ? 'VPN access for everyday private use.' : 'VPN-доступ для повседневного личного использования.') }}</span>
                                    </div>
                                </div>
                            </div>

                            <ul class="znet-plan-list">
                                <li>
                                    <span class="znet-check">✓</span>
                                    <span>{{ is_en ? 'Access instructions by email' : 'Доступ и инструкции на email' }}</span>
                                </li>
                                <li>
                                    <span class="znet-check">✓</span>
                                    <span>{{ is_en ? 'Manage everything in one account' : 'Управление в одном кабинете' }}</span>
                                </li>
                            </ul>

                            <a class="znet-btn {% if loop.index == 2 %}znet-btn-accent{% else %}znet-btn-outline{% endif %} znet-plan-btn" href="{{ base_href }}">{{ is_en ? 'Choose' : 'Выбрать' }}</a>
                        </article>
                    {% else %}
                        <div class="znet-plans-empty">
                            {{ is_en ? 'Plans are being updated.' : 'Тарифы обновляются.' }}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
    </main>

    <footer id="support" class="znet-site-footer">
        <div class="znet-container znet-footer-shell">
            <div class="znet-footer-brand">
                <img class="znet-brand-logo znet-footer-brand-logo" src="{{ 'img/znet/Logo.png'|asset_url }}" alt="Znet">
            </div>
            <nav class="znet-footer-nav" aria-label="{{ is_en ? 'Footer navigation' : 'Навигация в подвале' }}">
                <a href="#plans">{{ is_en ? 'Plans' : 'Тарифы' }}</a>
                <a href="{{ '/payment'|link }}">{{ is_en ? 'Payment' : 'Оплата' }}</a>
                <a href="{{ '/about-us'|link }}">{{ is_en ? 'About' : 'О сервисе' }}</a>
                <a href="{{ '/offer'|link }}">{{ is_en ? 'Offer' : 'Оферта' }}</a>
                <a href="{{ '/tos'|link }}">{{ is_en ? 'Agreement' : 'Соглашение' }}</a>
                <a href="{{ '/privacy-policy'|link }}">{{ is_en ? 'Privacy' : 'Конфиденциальность' }}</a>
                <a href="{{ '/refund-policy'|link }}">{{ is_en ? 'Refunds' : 'Возврат' }}</a>
                <a href="{{ '/contacts'|link }}">{{ is_en ? 'Support' : 'Поддержка' }}</a>
            </nav>
        </div>
    </footer>
</div>

<script>
    (() => {
        const setCookie = function (name, value, days) {
            let expires = '';

            if (days) {
                const date = new Date();
                date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);
                expires = '; expires=' + date.toUTCString();
            }

            document.cookie = name + '=' + encodeURIComponent(value) + expires + '; path=/; SameSite=Lax';
        };

        document.querySelectorAll('[data-znet-locale]').forEach((button) => {
            button.addEventListener('click', () => {
                const locale = button.getAttribute('data-znet-locale');

                if (!locale || locale === '{{ current_locale }}') {
                    return;
                }

                setCookie('fb_locale', locale, 365);
                window.location.reload();
            });
        });
    })();

    (() => {
        const header = document.querySelector('.znet-site-header-mobile');
        const toggle = header?.querySelector('.znet-header-menu-toggle');
        const nav = header?.querySelector('#znet-mobile-header-nav');

        if (!header || !toggle || !nav) {
            return;
        }

        const closeMenu = () => {
            header.classList.remove('is-menu-open');
            toggle.setAttribute('aria-expanded', 'false');
        };

        const openMenu = () => {
            header.classList.add('is-menu-open');
            toggle.setAttribute('aria-expanded', 'true');
        };

        toggle.addEventListener('click', () => {
            if (header.classList.contains('is-menu-open')) {
                closeMenu();
            } else {
                openMenu();
            }
        });

        nav.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', closeMenu);
        });

        document.addEventListener('click', (event) => {
            if (!header.contains(event.target)) {
                closeMenu();
            }
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                closeMenu();
            }
        });
    })();

    (() => {
        const layer = document.querySelector('[data-auth-layer]');
        const panels = layer ? Array.from(layer.querySelectorAll('[data-auth-panel]')) : [];
        const closers = layer ? Array.from(layer.querySelectorAll('[data-auth-close]')) : [];
        const switchers = layer ? Array.from(layer.querySelectorAll('[data-auth-switch]')) : [];
        const loginOpeners = Array.from(document.querySelectorAll(
            '.znet-site-header-desktop .znet-btn-ghost.znet-btn-with-icon, ' +
            '.znet-site-header-mobile .znet-header-actions > a.znet-btn-icon-only'
        ));
        const signupOpeners = Array.from(document.querySelectorAll(
            '.znet-site-header-desktop .znet-btn-accent, ' +
            '.znet-hero-actions .znet-btn-outline'
        ));
        const openers = [...loginOpeners, ...signupOpeners];
        const desktopHeaderBar = document.querySelector('.znet-site-header-desktop .znet-header-bar');
        const mobileHeaderBar = document.querySelector('.znet-site-header-mobile .znet-header-bar');
        const mobileHeader = document.querySelector('.znet-site-header-mobile');
        let activePanelName = null;

        if (!layer || panels.length === 0) {
            return;
        }

        const getMountTarget = () => window.matchMedia('(max-width: 920px)').matches ? mobileHeaderBar : desktopHeaderBar;

        const mountLayer = () => {
            const target = getMountTarget();

            if (target && layer.parentElement !== target) {
                target.appendChild(layer);
            }
        };

        const setPanel = (panelName) => {
            let activePanel = null;
            activePanelName = panelName;
            layer.dataset.authPanelState = panelName;

            panels.forEach((panel) => {
                const isActive = panel.dataset.authPanel === panelName;
                panel.hidden = !isActive;
                if (isActive) {
                    activePanel = panel;
                }
            });

            if (mobileHeader) {
                mobileHeader.classList.remove('is-menu-open');
                const toggle = mobileHeader.querySelector('.znet-header-menu-toggle');
                if (toggle) {
                    toggle.setAttribute('aria-expanded', 'false');
                }
            }

            if (activePanel) {
                const firstField = activePanel.querySelector('input, select, textarea, button');
                if (firstField) {
                    window.setTimeout(() => firstField.focus(), 20);
                }
            }
        };

        const openLayer = (panelName) => {
            if (!layer.hidden && activePanelName === panelName) {
                closeLayer();
                return;
            }

            mountLayer();
            layer.hidden = false;
            setPanel(panelName);
        };

        const closeLayer = () => {
            layer.hidden = true;
            delete layer.dataset.authPanelState;
            panels.forEach((panel) => {
                panel.hidden = true;
            });
            activePanelName = null;
        };

        const bindOpeners = (elements, panelName) => {
            elements.forEach((element) => {
                element.addEventListener('click', (event) => {
                    if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
                        return;
                    }

                    event.preventDefault();
                    openLayer(panelName);
                });
            });
        };

        bindOpeners(loginOpeners, 'login');
        bindOpeners(signupOpeners, 'signup');

        closers.forEach((closer) => {
            closer.addEventListener('click', closeLayer);
        });

        switchers.forEach((switcher) => {
            switcher.addEventListener('click', (event) => {
                if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
                    return;
                }

                event.preventDefault();
                event.stopPropagation();
                setPanel(switcher.dataset.authSwitch);
            });
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && !layer.hidden) {
                closeLayer();
            }
        });

        window.addEventListener('resize', () => {
            if (!layer.hidden) {
                mountLayer();
            }
        });

        document.addEventListener('click', (event) => {
            if (layer.hidden) {
                return;
            }

            const target = event.target;
            const clickedInsidePanel = panels.some((panel) => panel.contains(target));
            const clickedOpener = openers.some((opener) => opener.contains(target));

            if (!clickedInsidePanel && !clickedOpener) {
                closeLayer();
            }
        });
    })();

    (() => {
        document.querySelectorAll('.znet-plan-card').forEach((card) => {
            const select = card.querySelector('[data-plan-period]');
            const price = card.querySelector('[data-plan-price]');
            const button = card.querySelector('.znet-plan-btn');

            if (!select || !price || !button) {
                return;
            }

            const syncPlanCard = () => {
                const option = select.options[select.selectedIndex];

                if (!option) {
                    return;
                }

                if (option.dataset.price) {
                    price.textContent = option.dataset.price;
                }

                if (option.dataset.href) {
                    button.setAttribute('href', option.dataset.href);
                }
            };

            select.addEventListener('change', syncPlanCard);
            syncPlanCard();
        });
    })();
</script>
