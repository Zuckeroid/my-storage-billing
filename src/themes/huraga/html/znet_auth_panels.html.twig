{% import "macro_functions.html.twig" as mf %}

{% set required_fields = guest.client_required|default([]) %}
{% set custom_fields = guest.client_custom_fields|default({}) %}

<div class="znet-auth-layer" hidden data-auth-layer>
    <div class="znet-auth-backdrop" data-auth-close></div>

    <div class="znet-container znet-auth-shell">
        <section class="znet-auth-panel" data-auth-panel="login" hidden aria-labelledby="znet-auth-login-title">
            <div class="znet-auth-head">
                <div>
                    <span class="znet-auth-kicker">{{ is_en ? 'Login' : 'Войти' }}</span>
                    <h2 id="znet-auth-login-title">{{ is_en ? 'Open your account' : 'Открыть аккаунт' }}</h2>
                    <p>{{ is_en ? 'Use your email and password.' : 'Используйте email и пароль от аккаунта.' }}</p>
                </div>

                <button class="znet-auth-close" type="button" data-auth-close aria-label="{{ is_en ? 'Close' : 'Закрыть' }}">
                    <svg class="znet-btn-svg-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 6l12 12"></path>
                        <path d="M18 6L6 18"></path>
                    </svg>
                </button>
            </div>

            <form method="post" action="{{ 'api/guest/client/login'|link }}" class="auth znet-auth-form" {{ fb_api_form({redirect: '/'|link}) }}>
                <div class="mb-3">
                    <label class="form-label" for="znet-login-email">{{ 'Email'|trans }}</label>
                    <input
                        class="form-control"
                        id="znet-login-email"
                        type="email"
                        name="email"
                        value="{{ request.email }}"
                        placeholder="{{ 'Enter your email address'|trans }}"
                        required="required"
                        autocomplete="email"
                    >
                </div>

                <div class="mb-3">
                    <label class="form-label" for="znet-login-password">{{ 'Password'|trans }}</label>
                    <input
                        class="form-control"
                        id="znet-login-password"
                        type="password"
                        name="password"
                        placeholder="{{ 'Enter your password'|trans }}"
                        required="required"
                        autocomplete="current-password"
                    >
                </div>

                <button type="submit" class="znet-btn znet-btn-accent znet-auth-submit">
                    {{ is_en ? 'Login' : 'Войти' }}
                </button>
            </form>

            <div class="znet-auth-foot">
                {% if settings.show_password_reset_link %}
                    <a class="znet-auth-text-link" href="{{ 'password-reset'|link }}">
                        {{ 'Forgot password?'|trans }}
                    </a>
                {% endif %}

                <button class="znet-auth-text-link" type="button" data-auth-switch="signup">
                    {{ is_en ? 'Create account' : 'Создать аккаунт' }}
                </button>
            </div>
        </section>

        <section class="znet-auth-panel znet-auth-panel-signup" data-auth-panel="signup" hidden aria-labelledby="znet-auth-signup-title">
            <div class="znet-auth-head">
                <div>
                    <span class="znet-auth-kicker">{{ is_en ? 'Signup' : 'Регистрация' }}</span>
                    <h2 id="znet-auth-signup-title">{{ is_en ? 'Create your account' : 'Создать аккаунт' }}</h2>
                    <p>{{ is_en ? 'Start with the basics and finish in one step.' : 'Начните с базовых данных и завершите регистрацию за один шаг.' }}</p>
                </div>

                <button class="znet-auth-close" type="button" data-auth-close aria-label="{{ is_en ? 'Close' : 'Закрыть' }}">
                    <svg class="znet-btn-svg-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 6l12 12"></path>
                        <path d="M18 6L6 18"></path>
                    </svg>
                </button>
            </div>

            <form method="post" action="{{ 'api/guest/client/create'|link }}" class="auth znet-auth-form" {{ fb_api_form({redirect: '/'|link}) }}>
                <div class="znet-auth-grid znet-auth-grid-two">
                    <div class="mb-3">
                        <label class="form-label" for="znet-signup-first-name">{{ 'First Name'|trans }}</label>
                        <input
                            class="form-control"
                            id="znet-signup-first-name"
                            type="text"
                            name="first_name"
                            value="{{ request.first_name }}"
                            required="required"
                            autocomplete="given-name"
                        >
                    </div>

                    {% if 'last_name' in required_fields %}
                        <div class="mb-3">
                            <label class="form-label" for="znet-signup-last-name">{{ 'Last Name'|trans }}</label>
                            <input
                                class="form-control"
                                id="znet-signup-last-name"
                                type="text"
                                name="last_name"
                                value="{{ request.last_name }}"
                                required="required"
                                autocomplete="family-name"
                            >
                        </div>
                    {% endif %}
                </div>

                <div class="mb-3">
                    <label class="form-label" for="znet-signup-email">{{ 'Email Address'|trans }}</label>
                    <input
                        class="form-control"
                        id="znet-signup-email"
                        type="email"
                        name="email"
                        value="{{ request.email }}"
                        required="required"
                        autocomplete="email"
                    >
                    <div class="form-text">{{ 'Access instructions will be sent to this email after payment.'|trans }}</div>
                </div>

                {% if 'company' in required_fields %}
                    <div class="mb-3">
                        <label class="form-label" for="znet-signup-company">{{ 'Company'|trans }}</label>
                        <input class="form-control" id="znet-signup-company" type="text" name="company" value="{{ request.company }}" required="required">
                    </div>
                {% endif %}

                {% if 'birthday' in required_fields %}
                    <div class="mb-3">
                        <label class="form-label" for="znet-signup-birthday">{{ 'Birthday'|trans }}</label>
                        <input class="form-control" id="znet-signup-birthday" type="date" name="birthday" value="">
                    </div>
                {% endif %}

                {% if 'gender' in required_fields %}
                    <div class="mb-3">
                        <label class="form-label" for="znet-signup-gender">{{ 'Gender'|trans }}</label>
                        <select class="form-select" id="znet-signup-gender" name="gender">
                            <option value="male">{{ 'Male'|trans }}</option>
                            <option value="female">{{ 'Female'|trans }}</option>
                            <option value="nonbinary">{{ 'Non-binary'|trans }}</option>
                            <option value="other">{{ 'Other'|trans }}</option>
                        </select>
                    </div>
                {% endif %}

                {% if 'address_1' in required_fields %}
                    <div class="mb-3">
                        <label class="form-label" for="znet-signup-address-1">{{ 'Address'|trans }}</label>
                        <input class="form-control" id="znet-signup-address-1" type="text" name="address_1" value="{{ request.address_1 }}">
                    </div>
                {% endif %}

                {% if 'address_2' in required_fields %}
                    <div class="mb-3">
                        <label class="form-label" for="znet-signup-address-2">{{ 'Address 2'|trans }}</label>
                        <input class="form-control" id="znet-signup-address-2" type="text" name="address_2" value="{{ request.address_2 }}">
                    </div>
                {% endif %}

                <div class="znet-auth-grid znet-auth-grid-two">
                    {% if 'city' in required_fields %}
                        <div class="mb-3">
                            <label class="form-label" for="znet-signup-city">{{ 'City'|trans }}</label>
                            <input class="form-control" id="znet-signup-city" type="text" name="city" value="{{ request.city }}">
                        </div>
                    {% endif %}

                    {% if 'state' in required_fields %}
                        <div class="mb-3">
                            <label class="form-label" for="znet-signup-state">{{ 'State'|trans }}</label>
                            <input class="form-control" id="znet-signup-state" type="text" name="state" value="{{ request.state }}">
                        </div>
                    {% endif %}
                </div>

                <div class="znet-auth-grid znet-auth-grid-two">
                    {% if 'country' in required_fields %}
                        <div class="mb-3">
                            <label class="form-label" for="znet-signup-country">{{ 'Country'|trans }}</label>
                            <select class="form-select" id="znet-signup-country" name="country" required="required">
                                <option value="">{{ '-- Select country --'|trans }}</option>
                                {% for val, label in guest.system_countries %}
                                    <option value="{{ val }}" label="{{ label|e }}" {% if guest.system_default_country == val %}selected{% endif %}>{{ label|e }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}

                    {% if 'postcode' in required_fields %}
                        <div class="mb-3">
                            <label class="form-label" for="znet-signup-postcode">{{ 'Zip/Postal Code'|trans }}</label>
                            <input class="form-control" id="znet-signup-postcode" type="text" name="postcode" value="{{ request.postcode }}">
                        </div>
                    {% endif %}
                </div>

                {% if 'phone' in required_fields %}
                    <div class="mb-3">
                        <label class="form-label" for="znet-signup-phone">{{ 'Phone Number'|trans }}</label>
                        <div class="znet-auth-phone-group">
                            <input class="form-control znet-auth-phone-cc" id="znet-signup-phone-cc" type="text" name="phone_cc" value="" placeholder="+7">
                            <input class="form-control" id="znet-signup-phone" type="text" name="phone" value="{{ request.phone }}" placeholder="{{ 'Phone Number'|trans }}">
                        </div>
                    </div>
                {% endif %}

                {% for field_name, field in custom_fields %}
                    {% if field.active %}
                        <div class="mb-3">
                            <label class="form-label" for="znet-signup-{{ field_name }}">
                                {{ field.title is not empty ? field.title : field_name | capitalize }}
                            </label>
                            <input
                                class="form-control"
                                id="znet-signup-{{ field_name }}"
                                type="text"
                                name="{{ field_name }}"
                                value="{{ request.(field_name) }}"
                                {% if field.required %}required="required"{% endif %}
                            >
                        </div>
                    {% endif %}
                {% endfor %}

                <div class="znet-auth-grid znet-auth-grid-two">
                    <div class="mb-3">
                        <label class="form-label" for="znet-signup-password">{{ 'Password'|trans }}</label>
                        <input
                            class="form-control"
                            id="znet-signup-password"
                            type="password"
                            name="password"
                            value=""
                            required="required"
                            autocomplete="new-password"
                        >
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="znet-signup-password-confirm">{{ 'Password confirm'|trans }}</label>
                        <input
                            class="form-control"
                            id="znet-signup-password-confirm"
                            type="password"
                            name="password_confirm"
                            value=""
                            required="required"
                            autocomplete="new-password"
                        >
                    </div>
                </div>

                {{ mf.recaptcha }}

                {% if settings.signup_tos == 'explicit' %}
                    <div class="form-check znet-auth-check mb-3">
                        <input class="form-check-input" type="checkbox" value="" id="znet-signup-tos" required>
                        <label class="form-check-label" for="znet-signup-tos">
                            <span>
                                {{ is_en ? 'I agree to the' : 'Я принимаю' }}
                                <a href="{{ '/tos'|link }}" target="_blank" rel="noopener">{{ 'terms of service'|trans }}</a>
                                {{ is_en ? 'and' : 'и' }}
                                <a href="{{ '/privacy-policy'|link }}" target="_blank" rel="noopener">{{ 'privacy policy'|trans }}</a>.
                            </span>
                        </label>
                    </div>
                {% endif %}

                <button class="znet-btn znet-btn-accent znet-auth-submit" type="submit">
                    {{ is_en ? 'Create account' : 'Создать аккаунт' }}
                </button>

                {% if settings.signup_tos == 'implicit' %}
                    <div class="znet-auth-legal">
                        <span>
                            {{ is_en ? 'By creating an account, you agree to our' : 'Создавая аккаунт, вы принимаете' }}
                            <a href="{{ '/tos'|link }}" target="_blank" rel="noopener">{{ 'terms of service'|trans }}</a>
                            {{ is_en ? 'and' : 'и' }}
                            <a href="{{ '/privacy-policy'|link }}" target="_blank" rel="noopener">{{ 'privacy policy'|trans }}</a>.
                        </span>
                    </div>
                {% endif %}
            </form>

            <div class="znet-auth-foot">
                <button class="znet-auth-text-link" type="button" data-auth-switch="login">
                    {{ is_en ? 'Already have an account?' : 'Уже есть аккаунт?' }}
                </button>

                {% if settings.show_password_reset_link %}
                    <a class="znet-auth-text-link" href="{{ 'password-reset'|link }}">
                        {{ 'Forgot password?'|trans }}
                    </a>
                {% endif %}
            </div>
        </section>
    </div>
</div>
