{% set is_en = is_en|default(guest.system_locale|default(settings.locale|default('ru_RU')) starts with 'en') %}
{% set storage_plan_view = storage_plan_view|default('cards') %}
{% set storage_products = guest.product_get_list({ 'per_page': 100, 'show_hidden': false, 'type': 'custom' }).list|default([]) %}

{% if storage_plan_view == 'list' %}<ul class="mb-0">{% endif %}
{% for product in storage_products %}
    {% set title = product.title %}
    {% set price = '' %}
    {% set period = '' %}
    {% if product.pricing.type == 'recurrent' and product.pricing.recurrent['1M'] is defined and product.pricing.recurrent['1M'].enabled %}
        {% set price = product.pricing.recurrent['1M'].price|money_convert|replace({'.00': ''}) %}
        {% set period = is_en ? '1 month' : '1 месяц' %}
    {% elseif product.pricing.type == 'once' %}
        {% set price = product.pricing.once.price|money_convert|replace({'.00': ''}) %}
    {% elseif product.pricing.type == 'free' %}
        {% set price = 0|money_convert %}
    {% endif %}
    {% set description = product.description ? product.description|striptags : '' %}
    {% set plan_description = description ?: (is_en ? 'VPN access for everyday private use.' : 'VPN-доступ для повседневного личного использования.') %}
    {% set href = client ? ('invoice'|link ~ '#plans') : ('signup'|link) %}

    {% if storage_plan_view == 'dashboard_cards' %}
        <article class="znet-plan-card{% if loop.index == 2 %} znet-plan-card-featured{% endif %}">
            {% if loop.index == 2 %}
                <div class="znet-plan-badge">{{ is_en ? 'Popular' : 'Оптимальный' }}</div>
            {% endif %}

            <div class="znet-plan-top">
                <div class="znet-plan-summary">
                    <span class="znet-plan-name">{{ title }}</span>
                    {% if price %}
                        <strong class="znet-plan-price">{{ price }}</strong>
                    {% endif %}
                    {% if period %}
                        <span class="znet-plan-period">{{ period }}</span>
                    {% endif %}
                    <div class="znet-plan-highlight">
                        <span class="znet-check">✓</span>
                        <span>{{ plan_description }}</span>
                    </div>
                </div>
            </div>

            <a class="znet-btn {% if loop.index == 2 %}znet-btn-accent{% else %}znet-btn-outline{% endif %} znet-plan-btn" href="{{ href }}">{{ is_en ? 'Choose' : 'Выбрать' }}</a>
        </article>
    {% elseif storage_plan_view == 'card_items' %}
        <div class="col-md-4 mb-3">
            <div class="card h-100 storage-plan-card">
                <div class="card-body d-flex flex-column">
                    <span class="storage-card-icon" aria-hidden="true">
                        <svg class="svg-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M4 4.75C4 3.78 4.78 3 5.75 3h6.5L18 8.75v10.5c0 .97-.78 1.75-1.75 1.75H5.75C4.78 21 4 20.22 4 19.25V4.75Zm8 0V9h4.25L12 4.75Z"/>
                        </svg>
                    </span>
                    <h2 class="h5">{{ title }}</h2>
                    {% if price %}
                        <p class="h4 mb-3">{{ price }}{% if period %} / {{ period }}{% endif %}</p>
                    {% endif %}
                    {% if description %}
                        <p class="text-secondary small flex-grow-1">{{ description }}</p>
                    {% endif %}
                    <a class="btn btn-primary w-100 mt-auto" href="{{ href }}">{{ is_en ? 'Choose plan' : 'Выбрать тариф' }}</a>
                </div>
            </div>
        </div>
    {% elseif storage_plan_view == 'list' %}
        <li>{{ title }}{% if price %}: {{ price }}{% if period %} / {{ period }}{% endif %}{% endif %}{% if description %}. {{ description }}{% endif %}</li>
    {% elseif storage_plan_view == 'inline' %}
        {{ title }}{% if price %} - {{ price }}{% if period %} / {{ period }}{% endif %}{% endif %}{% if not loop.last %}, {% endif %}
    {% endif %}
{% else %}
    {% if storage_plan_view == 'dashboard_cards' %}
        <div class="znet-plans-empty">
                            {{ is_en ? 'Plans are being updated.' : 'Тарифы обновляются.' }}
        </div>
    {% elseif storage_plan_view == 'card_items' %}
        <div class="col-12">
            <p class="text-secondary mb-0">{{ is_en ? 'Plans are being updated.' : 'Тарифы обновляются.' }}</p>
        </div>
    {% elseif storage_plan_view == 'list' %}
        <li>{{ is_en ? 'Plans are being updated.' : 'Тарифы обновляются.' }}</li>
    {% elseif storage_plan_view == 'inline' %}
        {{ is_en ? 'plans are being updated' : 'тарифы обновляются' }}
    {% endif %}
{% endfor %}
{% if storage_plan_view == 'list' %}</ul>{% endif %}
