<div class="znet-login-card{{ login_panel_class is defined ? ' ' ~ login_panel_class : '' }}" id="{{ panel_id }}" data-login-panel aria-hidden="true">
    <div class="znet-login-card-head">
        <h3>{{ 'Login to your storage account'|trans }}</h3>
    </div>

    <form method="post" action="{{ 'api/guest/client/login'|link }}" class="znet-login-form" {{ fb_api_form({redirect: '/'|link}) }}>
        <div class="znet-login-field">
            <label for="{{ panel_id }}-email">{{ 'Email'|trans }}</label>
            <input
                id="{{ panel_id }}-email"
                type="email"
                name="email"
                value="{{ request.email }}"
                placeholder="{{ 'Enter your email address'|trans }}"
                autocomplete="email"
                required="required"
            >
        </div>

        <div class="znet-login-field">
            <label for="{{ panel_id }}-password">{{ 'Password'|trans }}</label>
            <input
                id="{{ panel_id }}-password"
                type="password"
                name="password"
                value="{{ request.password }}"
                placeholder="{{ 'Enter your password'|trans }}"
                autocomplete="current-password"
                required="required"
            >
        </div>

        <button type="submit" class="znet-btn znet-btn-accent znet-login-submit">{{ 'Login'|trans }}</button>
    </form>

    {% if settings.show_password_reset_link or settings.show_signup_link %}
        <div class="znet-login-links">
            {% if settings.show_signup_link %}
                <a class="znet-login-link" href="{{ 'signup'|link }}">{{ 'Create storage account'|trans }}</a>
            {% endif %}
            {% if settings.show_password_reset_link %}
                <a class="znet-login-link" href="{{ 'password-reset'|link }}">{{ 'Forgot password?'|trans }}</a>
            {% endif %}
        </div>
    {% endif %}
</div>
