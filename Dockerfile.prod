FROM php:8.3-apache

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        cron \
        git \
        libbz2-dev \
        libcurl4-openssl-dev \
        libicu-dev \
        libonig-dev \
        libpng-dev \
        libzip-dev \
        unzip \
    && a2enmod rewrite \
    && docker-php-ext-configure gd \
    && docker-php-ext-install -j1 \
        bz2 \
        curl \
        gd \
        intl \
        mbstring \
        pdo_mysql \
        zip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

COPY composer.json composer.lock ./
COPY src ./src
COPY docker/php/conf.d/zz-security.ini /usr/local/etc/php/conf.d/zz-security.ini
COPY docker/entrypoint-prod.sh /usr/local/bin/entrypoint-prod.sh

RUN composer install --no-dev --prefer-dist --no-interaction --optimize-autoloader \
    && rm -rf src/install \
    && mkdir -p src/data/cache src/data/log src/data/uploads \
    && chown -R www-data:www-data src/data \
    && echo '*/5 * * * * /usr/local/bin/php /var/www/html/cron.php >> /var/log/cron.log 2>&1' > /tmp/www-data.cron \
    && crontab -u www-data /tmp/www-data.cron \
    && rm /tmp/www-data.cron \
    && rm -rf /var/www/html \
    && mv /app/src /var/www/html \
    && chown -R www-data:www-data /var/www/html \
    && chmod +x /usr/local/bin/entrypoint-prod.sh

CMD ["/usr/local/bin/entrypoint-prod.sh"]
